# Salin ke .env lalu isi nilainya
DATABASE_URL="mysql://user:password@127.0.0.1:3306/taska?connection_limit=20"
ARCHIVE_DATABASE_URL="mysql://user:password@127.0.0.1:3306/taska_archive?connection_limit=5"
JWT_SECRET="ganti-dengan-random-64-hex"
JWT_ACCESS_TTL="12h"
JWT_REFRESH_TTL="7d"
PORT=3000
UPLOAD_DIR="./uploads"

# Kunci Enkripsi Kredensial File Management (AES-256-GCM, 32 byte hex / base64 / string acak)
FILE_SECRET_KEY="ganti-dengan-kunci-enkripsi-rahasia-32-byte-file-storage"

# (Opsional) Storage Provider bawaan via ENV
# FILE_STORAGE_MINIO_TYPE="S3"
# FILE_STORAGE_MINIO_ENDPOINT="http://localhost:9000"
# FILE_STORAGE_MINIO_BUCKET="akuntra"
# FILE_STORAGE_MINIO_REGION="auto"
# FILE_STORAGE_MINIO_ACCESS_KEY="minioadmin"
# FILE_STORAGE_MINIO_SECRET_KEY="minioadmin"
