// ─────────────────────────────── Contract Management ───────────────────────────────

model CtrType {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts       CtrContract[]
  expirationRules CtrExpirationRule[]

  @@index([isActive])
  @@map("contract_types")
}

model CtrContract {
  id               Int       @id @default(autoincrement())
  contractNumber   String    @unique
  officialNumber   String?
  title            String
  typeId           Int
  type             CtrType   @relation(fields: [typeId], references: [id])
  counterpartyType String    @default("VENDOR")
  counterpartyId   Int?
  counterpartyName String
  effectiveDate    DateTime  @db.Date
  expirationDate   DateTime  @db.Date
  renewalDate      DateTime? @db.Date
  isAutoRenewal    Boolean   @default(false)
  currency         String    @default("IDR")
  contractValue    Decimal   @default(0.00) @db.Decimal(18, 2)
  contractOwnerId  Int?
  department       String
  paymentTerms     String?
  paymentFrequency String    @default("ONE_TIME")
  status           String    @default("ACTIVE")
  approvalStatus   String    @default("DRAFT")
  description      String?   @db.Text
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parties          CtrParty[]
  documents        CtrDocument[]
  services         CtrService[]
  slas             CtrSla[]
  terms            CtrTerm[]
  financial        CtrFinancial?
  paymentSchedules CtrPaymentSchedule[]
  renewals         CtrRenewal[]
  approvals        CtrApproval[]
  notifications    CtrNotification[]
  amendments       CtrAmendment[]
  termination      CtrTermination?
  relations        CtrRelation[]
  auditLogs        CtrAuditLog[]

  @@index([typeId])
  @@index([counterpartyType, counterpartyId])
  @@index([status])
  @@index([approvalStatus])
  @@index([expirationDate])
  @@index([renewalDate])
  @@index([department])
  @@index([contractOwnerId])
  @@map("contracts")
}

model CtrParty {
  id         Int         @id @default(autoincrement())
  contractId Int
  contract   CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyType  String
  entityType String      @default("OTHER")
  entityId   Int?
  name       String
  role       String?
  address    String?     @db.Text
  picName    String?
  picEmail   String?
  picPhone   String?
  createdAt  DateTime    @default(now())

  @@index([contractId])
  @@index([entityType, entityId])
  @@map("contract_parties")
}

model CtrDocument {
  id                   Int         @id @default(autoincrement())
  contractId           Int
  contract             CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentCategory     String
  documentTitle        String
  documentNumber       String?
  isConfidential       Boolean     @default(false)
  signedDate           DateTime?   @db.Date
  signedByFirstParty   String?
  signedBySecondParty  String?
  currentVersionNumber Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  versions CtrDocumentVersion[]

  @@index([contractId])
  @@index([documentCategory])
  @@map("contract_documents")
}

model CtrDocumentVersion {
  id                  Int         @id @default(autoincrement())
  documentId          Int
  document            CtrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber       Int         @default(1)
  fileId              Int?
  fileUrl             String      @db.VarChar(500)
  fileName            String
  fileSize            Int?
  mimeType            String?
  changeSummary       String?     @db.Text
  isLockedForApproval Boolean     @default(false)
  uploadedById        Int?
  createdAt           DateTime    @default(now())

  approvals CtrApproval[]

  @@index([documentId, versionNumber])
  @@map("contract_document_versions")
}

model CtrService {
  id              Int         @id @default(autoincrement())
  contractId      Int
  contract        CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceName     String
  serviceScope    String?     @db.Text
  servicePeriod   String?
  serviceLocation String?
  supportContact  String?
  serviceFee      Decimal?    @db.Decimal(18, 2)
  penaltyClause   String?     @db.Text
  renewalTerms    String?     @db.Text
  createdAt       DateTime    @default(now())

  slas CtrSla[]

  @@index([contractId])
  @@map("contract_services")
}

model CtrSla {
  id               Int         @id @default(autoincrement())
  contractId       Int
  contract         CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId        Int?
  service          CtrService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  indicatorName    String
  targetMetric     String
  responseHours    Decimal?    @db.Decimal(6, 2)
  resolutionHours  Decimal?    @db.Decimal(6, 2)
  penaltyDetails   String?     @db.Text
  operationalHours String?     @default("8x5")
  createdAt        DateTime    @default(now())

  @@index([contractId])
  @@index([serviceId])
  @@map("contract_sla")
}

model CtrTerm {
  id           Int         @id @default(autoincrement())
  contractId   Int
  contract     CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  termType     String
  clauseNumber String?     @db.VarChar(50)
  title        String
  content      String      @db.Text
  createdAt    DateTime    @default(now())

  @@index([contractId])
  @@index([termType])
  @@map("contract_terms")
}

model CtrFinancial {
  id                  Int         @id @default(autoincrement())
  contractId          Int         @unique
  contract            CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  valueType           String      @default("FIXED")
  currency            String      @default("IDR")
  baseAmount          Decimal     @default(0.00) @db.Decimal(18, 2)
  taxPercentage       Decimal     @default(0.00) @db.Decimal(5, 2)
  taxAmount           Decimal     @default(0.00) @db.Decimal(18, 2)
  totalAmount         Decimal     @default(0.00) @db.Decimal(18, 2)
  downPaymentAmount   Decimal     @default(0.00) @db.Decimal(18, 2)
  retentionAmount     Decimal     @default(0.00) @db.Decimal(18, 2)
  retentionPeriodDays Int?
  penaltyTerms        String?     @db.Text
  costCenter          String?
  projectReference    String?
  notes               String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("contract_financials")
}

model CtrPaymentSchedule {
  id               Int         @id @default(autoincrement())
  contractId       Int
  contract         CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  scheduleNumber   Int         @default(1)
  milestoneName    String
  dueDate          DateTime    @db.Date
  amount           Decimal     @db.Decimal(18, 2)
  taxAmount        Decimal     @default(0.00) @db.Decimal(18, 2)
  totalAmount      Decimal     @db.Decimal(18, 2)
  paymentStatus    String      @default("PLANNED")
  invoiceReference String?
  paidDate         DateTime?   @db.Date
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([contractId])
  @@index([dueDate])
  @@index([paymentStatus])
  @@map("contract_payment_schedules")
}

model CtrRenewal {
  id                     Int         @id @default(autoincrement())
  contractId             Int
  contract               CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  renewalNumber          Int         @default(1)
  renewalCode            String      @unique
  submissionDate         DateTime    @db.Date
  proposedEffectiveDate  DateTime    @db.Date
  proposedExpirationDate DateTime    @db.Date
  previousValue          Decimal     @db.Decimal(18, 2)
  proposedValue          Decimal     @db.Decimal(18, 2)
  reason                 String      @db.Text
  status                 String      @default("PENDING_REVIEW")
  submittedById          Int?
  reviewedById           Int?
  reviewedAt             DateTime?
  reviewComments         String?     @db.Text
  draftAddendumDocId     Int?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([contractId])
  @@index([status])
  @@map("contract_renewals")
}

model CtrApproval {
  id                        Int                 @id @default(autoincrement())
  contractId                Int
  contract                  CtrContract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stage                     String
  sequence                  Int                 @default(1)
  status                    String              @default("PENDING")
  approverId                Int?
  approverRole              String?
  decisionTimestamp         DateTime?
  comments                  String?             @db.Text
  approvedDocumentVersionId Int?
  approvedDocumentVersion   CtrDocumentVersion? @relation(fields: [approvedDocumentVersionId], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())

  @@index([contractId])
  @@index([status])
  @@map("contract_approvals")
}

model CtrExpirationRule {
  id          Int      @id @default(autoincrement())
  typeId      Int?
  type        CtrType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  daysOffset  Int
  label       String
  targetRole  String?
  notifyOwner Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([typeId])
  @@index([isActive])
  @@map("contract_expiration_rules")
}

model CtrNotification {
  id               Int         @id @default(autoincrement())
  contractId       Int
  contract         CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  notificationType String
  triggerPeriod    String?
  recipientUserId  Int?
  channel          String      @default("IN_APP")
  message          String      @db.Text
  sentAt           DateTime    @default(now())
  deliveryStatus   String      @default("DELIVERED")
  calendarEventId  Int?

  @@index([contractId, notificationType])
  @@index([sentAt])
  @@map("contract_notifications")
}

model CtrAmendment {
  id                Int         @id @default(autoincrement())
  contractId        Int
  contract          CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amendmentNumber   String
  amendmentDate     DateTime    @db.Date
  title             String
  description       String      @db.Text
  valueAdjustment   Decimal     @default(0.00) @db.Decimal(18, 2)
  newEffectiveDate  DateTime?   @db.Date
  newExpirationDate DateTime?   @db.Date
  documentId        Int?
  approvedById      Int?
  createdAt         DateTime    @default(now())

  @@index([contractId])
  @@index([amendmentDate])
  @@map("contract_amendments")
}

model CtrTermination {
  id                   Int         @id @default(autoincrement())
  contractId           Int         @unique
  contract             CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  terminationDate      DateTime    @db.Date
  reason               String      @db.Text
  penaltyAmount        Decimal     @default(0.00) @db.Decimal(18, 2)
  remainingObligations String?     @db.Text
  checklistConfirmed   Boolean     @default(false)
  beritaAcaraDocId     Int?
  approvedById         Int?
  status               String      @default("APPROVED")
  createdAt            DateTime    @default(now())

  @@map("contract_terminations")
}

model CtrRelation {
  id            Int         @id @default(autoincrement())
  contractId    Int
  contract      CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  relatedModule String
  relatedId     Int
  referenceCode String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([contractId])
  @@index([relatedModule, relatedId])
  @@map("contract_relations")
}

model CtrAuditLog {
  id           Int         @id @default(autoincrement())
  contractId   Int
  contract     CtrContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  action       String
  userId       Int?
  userName     String?
  fieldChanged String?
  oldValue     String?     @db.Text
  newValue     String?     @db.Text
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([contractId])
  @@index([createdAt])
  @@map("contract_audit_logs")
}



// ─────────────────────────────── Maintenance Management (EAM / CMMS) ───────────────────────────────

model MaintCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklists MaintChecklist[]
  plans      MaintPlan[]

  @@index([isActive])
  @@map("maintenance_categories")
}

model MaintChecklist {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  categoryId  Int
  category    MaintCategory @relation(fields: [categoryId], references: [id])
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MaintChecklistItem[]
  plans MaintPlan[]

  @@index([categoryId])
  @@map("maintenance_checklists")
}

model MaintChecklistItem {
  id                Int            @id @default(autoincrement())
  checklistId       Int
  checklist         MaintChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemText          String
  standardCondition String?
  sequence          Int            @default(1)
  isRequired        Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workOrderChecklists MaintWorkOrderChecklist[]

  @@index([checklistId])
  @@map("maintenance_checklist_items")
}

model MaintVendor {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?  @db.Text
  specialization String?
  rating         Decimal? @default(5.0) @db.Decimal(3, 1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  costs MaintCost[]

  @@index([isActive])
  @@map("maintenance_vendors")
}

model MaintPlan {
  id                Int           @id @default(autoincrement())
  planNumber        String        @unique
  title             String
  categoryId        Int
  category          MaintCategory @relation(fields: [categoryId], references: [id])
  method            String        @default("CALENDAR_BASED")
  intervalValue     Int           @default(1)
  intervalUnit      String        @default("MONTHS")
  checklistId       Int?
  checklist         MaintChecklist? @relation(fields: [checklistId], references: [id])
  picUserId         Int?
  picUser           User?         @relation("MaintPlanPic", fields: [picUserId], references: [id])
  autoGenerate      Boolean       @default(true)
  generationHorizon String        @default("NEXT_CYCLE")
  reminderLeadDays  String        @default("7,3,1")
  description       String?       @db.Text
  isActive          Boolean       @default(true)
  createdById       Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assets    MaintPlanAsset[]
  schedules MaintSchedule[]

  @@index([categoryId])
  @@index([checklistId])
  @@index([picUserId])
  @@index([isActive])
  @@map("maintenance_plans")
}

model MaintPlanAsset {
  id               Int       @id @default(autoincrement())
  planId           Int
  plan             MaintPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  assetId          Int
  asset            FaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  lastServiceDate  DateTime? @db.Date
  lastMeterReading Decimal?  @db.Decimal(18, 2)
  nextServiceDate  DateTime? @db.Date
  nextMeterReading Decimal?  @db.Decimal(18, 2)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([planId, assetId])
  @@index([planId])
  @@index([assetId])
  @@map("maintenance_plan_assets")
}

model MaintSchedule {
  id                  Int       @id @default(autoincrement())
  scheduleNumber      String    @unique
  planId              Int?
  plan                MaintPlan? @relation(fields: [planId], references: [id])
  assetId             Int
  asset               FaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scheduledDate       DateTime  @db.Date
  scheduledMeter      Decimal?  @db.Decimal(18, 2)
  maintenanceType     String    @default("PREVENTIVE")
  priority            String    @default("MEDIUM")
  assignedUserId      Int?
  assignedUser        User?     @relation("MaintScheduleAssigned", fields: [assignedUserId], references: [id])
  status              String    @default("SCHEDULED")
  rescheduleReason    String?   @db.Text
  rescheduledFromDate DateTime? @db.Date
  rescheduledByUserId Int?
  notes               String?   @db.Text
  createdById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workOrders MaintWorkOrder[]

  @@index([planId])
  @@index([assetId])
  @@index([scheduledDate])
  @@index([status])
  @@map("maintenance_schedules")
}

model MaintRequest {
  id                     Int       @id @default(autoincrement())
  requestNumber          String    @unique
  assetId                Int
  asset                  FaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporterUserId         Int
  reporterUser           User      @relation("MaintRequestReporter", fields: [reporterUserId], references: [id])
  requestDate            DateTime  @db.Date
  problemDescription     String    @db.Text
  urgency                String    @default("MEDIUM")
  initialInspectionNotes String?   @db.Text
  inspectedByUserId      Int?
  inspectedByUser        User?     @relation("MaintRequestInspector", fields: [inspectedByUserId], references: [id])
  inspectedAt            DateTime?
  status                 String    @default("DRAFT")
  rejectionReason        String?   @db.Text
  workOrderId            Int?
  createdById            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workOrders  MaintWorkOrder[]
  attachments MaintAttachment[]

  @@index([assetId])
  @@index([reporterUserId])
  @@index([status])
  @@index([workOrderId])
  @@map("maintenance_requests")
}

model MaintWorkOrder {
  id                       Int       @id @default(autoincrement())
  workOrderNumber          String    @unique
  assetId                  Int
  asset                    FaAsset   @relation(fields: [assetId], references: [id])
  maintenanceType          String    @default("PREVENTIVE")
  priority                 String    @default("MEDIUM")
  problemDescription       String    @db.Text
  workInstruction          String?   @db.Text
  assignedToUserId         Int?
  assignedToUser           User?     @relation("MaintWOAssigned", fields: [assignedToUserId], references: [id])
  plannedStartDate         DateTime? @db.Date
  plannedFinishDate        DateTime? @db.Date
  actualStartDate          DateTime?
  actualFinishDate         DateTime?
  totalSparePartCost       Decimal   @default(0.00) @db.Decimal(18, 2)
  totalLaborCost           Decimal   @default(0.00) @db.Decimal(18, 2)
  totalExternalServiceCost Decimal   @default(0.00) @db.Decimal(18, 2)
  totalTransportationCost  Decimal   @default(0.00) @db.Decimal(18, 2)
  totalOtherCost           Decimal   @default(0.00) @db.Decimal(18, 2)
  totalCost                Decimal   @default(0.00) @db.Decimal(18, 2)
  isCapitalized            Boolean   @default(false)
  capitalizationStatus     String?   @default("NONE")
  workResult               String?   @db.Text
  rootCause                String?   @db.Text
  correctiveAction         String?   @db.Text
  verificationNotes        String?   @db.Text
  verifiedByUserId         Int?
  verifiedByUser           User?     @relation("MaintWOVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt               DateTime?
  closedByUserId           Int?
  closedByUser             User?     @relation("MaintWOCloser", fields: [closedByUserId], references: [id])
  closedAt                 DateTime?
  status                   String    @default("DRAFT")
  requestId                Int?
  request                  MaintRequest?  @relation(fields: [requestId], references: [id])
  scheduleId               Int?
  schedule                 MaintSchedule? @relation(fields: [scheduleId], references: [id])
  createdById              Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tasks       MaintWorkOrderTask[]
  checklists  MaintWorkOrderChecklist[]
  materials   MaintMaterial[]
  labor       MaintLabor[]
  costs       MaintCost[]
  histories   MaintHistory[]
  downtimes   MaintDowntime[]
  attachments MaintAttachment[]

  @@index([assetId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([maintenanceType])
  @@index([priority])
  @@index([requestId])
  @@index([scheduleId])
  @@map("maintenance_work_orders")
}

model MaintWorkOrderTask {
  id                Int            @id @default(autoincrement())
  workOrderId       Int
  workOrder         MaintWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  taskName          String
  instruction       String?        @db.Text
  sequence          Int            @default(1)
  isCompleted       Boolean        @default(false)
  completedAt       DateTime?
  completedByUserId Int?
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([workOrderId])
  @@map("maintenance_work_order_tasks")
}

model MaintWorkOrderChecklist {
  id              Int                 @id @default(autoincrement())
  workOrderId     Int
  workOrder       MaintWorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checklistItemId Int?
  checklistItem   MaintChecklistItem? @relation(fields: [checklistItemId], references: [id])
  itemText        String
  conditionBefore String?
  conditionAfter  String?
  status          String              @default("PASS")
  notes           String?             @db.Text
  checkedByUserId Int?
  checkedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([workOrderId])
  @@index([checklistItemId])
  @@map("maintenance_work_order_checklists")
}

model MaintMaterial {
  id                Int            @id @default(autoincrement())
  workOrderId       Int
  workOrder         MaintWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId         Int?
  product           Product?       @relation(fields: [productId], references: [id])
  sparePartName     String
  partNumber        String?
  quantity          Decimal        @default(1.00) @db.Decimal(12, 2)
  unit              String         @default("PCS")
  unitCost          Decimal        @default(0.00) @db.Decimal(18, 2)
  totalCost         Decimal        @default(0.00) @db.Decimal(18, 2)
  source            String         @default("WAREHOUSE")
  warehouseId       Int?
  stockMovementId   Int?
  purchaseRequestId Int?
  status            String         @default("REQUESTED")
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([workOrderId])
  @@index([productId])
  @@map("maintenance_materials")
}

model MaintLabor {
  id               Int            @id @default(autoincrement())
  workOrderId      Int
  workOrder        MaintWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technicianUserId Int?
  technicianUser   User?          @relation("MaintLaborTechnician", fields: [technicianUserId], references: [id])
  technicianName   String
  hoursSpent       Decimal        @default(0.00) @db.Decimal(8, 2)
  hourlyRate       Decimal        @default(0.00) @db.Decimal(18, 2)
  laborCost        Decimal        @default(0.00) @db.Decimal(18, 2)
  workDescription  String?        @db.Text
  loggedDate       DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workOrderId])
  @@index([technicianUserId])
  @@map("maintenance_labor")
}

model MaintCost {
  id                    Int            @id @default(autoincrement())
  workOrderId           Int
  workOrder             MaintWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  costComponent         String
  description           String
  amount                Decimal        @default(0.00) @db.Decimal(18, 2)
  sourceTransactionType String         @default("MANUAL")
  sourceTransactionRef  String?
  journalId             Int?
  isCapitalized         Boolean        @default(false)
  coaCode               String?
  vendorId              Int?
  vendor                MaintVendor?   @relation(fields: [vendorId], references: [id])
  incurredDate          DateTime       @db.Date
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([workOrderId])
  @@index([costComponent])
  @@index([vendorId])
  @@map("maintenance_costs")
}

model MaintHistory {
  id                 Int            @id @default(autoincrement())
  assetId            Int
  asset              FaAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrderId        Int?
  workOrder          MaintWorkOrder? @relation(fields: [workOrderId], references: [id])
  maintenanceDate    DateTime       @db.Date
  maintenanceType    String         @default("PREVENTIVE")
  problemDescription String         @db.Text
  rootCause          String?        @db.Text
  correctiveAction   String?        @db.Text
  sparePartsSummary  String?        @db.Text
  technicianOrVendor String?
  totalCost          Decimal        @default(0.00) @db.Decimal(18, 2)
  assetDowntimeHours Decimal        @default(0.00) @db.Decimal(8, 2)
  photoBeforeUrl     String?        @db.Text
  photoAfterUrl      String?        @db.Text
  finalAssetStatus   String         @default("GOOD")
  createdAt          DateTime       @default(now())

  @@index([assetId])
  @@index([workOrderId])
  @@index([maintenanceDate])
  @@map("maintenance_history")
}

model MaintDowntime {
  id                Int            @id @default(autoincrement())
  assetId           Int
  asset             FaAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrderId       Int?
  workOrder         MaintWorkOrder? @relation(fields: [workOrderId], references: [id])
  downtimeStart     DateTime
  downtimeEnd       DateTime?
  durationHours     Decimal        @default(0.00) @db.Decimal(8, 2)
  cause             String         @db.Text
  operationalImpact String?        @default("FULL_STOP")
  status            String         @default("RECORDED")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([assetId])
  @@index([workOrderId])
  @@map("maintenance_downtime")
}

model MaintAttachment {
  id           Int            @id @default(autoincrement())
  workOrderId  Int?
  workOrder    MaintWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestId    Int?
  request      MaintRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId       Int?
  fileUrl      String         @db.Text
  documentType String         @default("REPORT")
  title        String
  notes        String?        @db.Text
  uploadedById Int?
  createdAt    DateTime       @default(now())

  @@index([workOrderId])
  @@index([requestId])
  @@map("maintenance_attachments")
}

model MaintApproval {
  id             Int       @id @default(autoincrement())
  referenceType  String
  referenceId    Int
  approverUserId Int
  approverUser   User      @relation("MaintApprovalUser", fields: [approverUserId], references: [id])
  status         String    @default("PENDING")
  notes          String?   @db.Text
  actedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([referenceType, referenceId])
  @@index([approverUserId])
  @@map("maintenance_approvals")
}

model MaintNotification {
  id              Int      @id @default(autoincrement())
  recipientUserId Int
  recipientUser   User     @relation("MaintNotificationRecipient", fields: [recipientUserId], references: [id])
  notificationType String
  title           String
  message         String   @db.Text
  referenceType   String?
  referenceId     Int?
  isRead          Boolean  @default(false)
  sentAt          DateTime @default(now())

  @@index([recipientUserId])
  @@index([isRead])
  @@map("maintenance_notifications")
}
