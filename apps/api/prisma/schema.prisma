// Taska — Mini ERP Operasional · Skema fase 1 (PRD)
// Dokumen: apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  BOS
  SALES
  PM
  TEKNISI
  PROCUREMENT
  FINANCE
  GUDANG
  SE
  HR
}

enum ActiveStatus {
  AKTIF
  NONAKTIF
}

enum LeadStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ClientType {
  PARTNER
  END_USER
  SI
}

enum FollowUpMethod {
  EMAIL
  TELEPON
  WA
  LAINNYA
}

enum FollowUpStatus {
  TERJADWAL
  SELESAI
}

enum SurveyStatus {
  DIMINTA
  DIJADWALKAN
  BERJALAN
  SELESAI
  BATAL
}

enum QuotationStatus {
  NOT_YET
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  NEGOTIATION
  REVISION
  EXPIRED
}

enum InvoiceOutStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  BATAL
}

enum InvoiceInStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  BATAL
}

enum InvoiceType {
  DP
  TERMIN
  PELUNASAN
}

enum PaymentMethod {
  TRANSFER
  TUNAI
  QRIS
  LAINNYA
}

enum ProjectType {
  CUSTOMER
  PRODUCT_RD
  INTERNAL
  MAINTENANCE
  SUPPORT
  OTHER
}

enum ProjectStatus {
  DIRENCANAKAN
  BERJALAN
  DITUNDA
  TERLAMBAT
  SELESAI
}

enum PaymentStatus {
  BELUM_LUNAS
  LUNAS_SEBAGIAN
  LUNAS
}

/// Uang jalan / kasbon operasional karyawan (survey, pengiriman barang, dll.)
enum CashAdvanceStatus {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DICAIRKAN
  DILAPORKAN
  SELESAI
  DIBATALKAN
}

enum CashAdvancePurpose {
  SURVEY
  PENGIRIMAN
  PROJECT
  LAINNYA
  /// Finance mengisi saldo petty cash karyawan langsung (tanpa pengajuan)
  ISI_SALDO
  /// Sisa saldo petty cash dikembalikan karyawan ke kas
  TARIK_SALDO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  REJECTED
  PENDING
  TESTED
}

enum Priority {
  RENDAH
  SEDANG
  TINGGI
  URGENT
}

enum CostType {
  PROJECT
  STOK
  INTERNAL
  LAINNYA
}

enum ItemCondition {
  BARU
  SECOND
}

enum PrStatus {
  DIAJUKAN
  CEK_STOK
  DISETUJUI
  DIBAYAR
  DITOLAK
  PO_DIBUAT
  DIKIRIM
  DITERIMA
  DIBATALKAN
}

enum PoStatus {
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  DITOLAK
  DIBATALKAN
}

enum ShipmentStatus {
  DI_SUPPLIER
  DIKIRIM
  SAMPAI
}

enum ReceivingStatus {
  MENUNGGU
  DITERIMA_SEBAGIAN
  DITERIMA
  DITOLAK
}

enum MovementType {
  IN
  OUT
  TRANSFER
}

enum MovementCategory {
  PENERIMAAN_SUPPLIER
  KELUAR_PROJECT
  KELUAR_SURAT_JALAN
  TRANSFER
  RETUR_PROJECT
  BARANG_TERPAKAI
  PENGGANTIAN
  PENYESUAIAN_OPNAME
  SALDO_AWAL
  LAINNYA
}

enum SerialStatus {
  DI_GUDANG
  RESERVED
  DIKIRIM
  TERPASANG
  RETUR
  DIGANTI
  RUSAK
}

enum DeliveryStatus {
  PENDING
  DIKIRIM
  DITERIMA
  DIBATALKAN
}

enum ExpenseStatus {
  DILAPORKAN
  DISETUJUI
  DITOLAK
  DIBAYAR
}

enum ApprovalStatus {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

enum ApprovalKind {
  PENAWARAN
  PERMINTAAN_SURVEY
  PURCHASE_REQUEST
  SUPPLIER_PO
  INVOICE_IN
  PENERIMAAN
  SURAT_JALAN
  PENGELUARAN
  OPNAME
}

enum OpnameStatus {
  DRAFT
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  DITOLAK
}

enum DamageStatus {
  DILAPORKAN
  DIPROSES
  SELESAI
}

// ─── Enum pembelian (dulu teks bebas) ───
enum ProcurementSource {
  SUPPLIER
  RETAIL
  GUDANG
}

enum PurchasePaymentMethod {
  KAS
  UTANG
}

enum PrPaymentStatus {
  BELUM_DIBAYAR
  DIBAYAR
}

enum PpnMode {
  none
  exclude
  include
}

enum PoManualStatus {
  LUNAS
  SAMPAI_BELUM_LUNAS
}

enum DamageCategory {
  KERUSAKAN
  RETUR_PENJUALAN
  RETUR_PEMBELIAN
}

enum IssueType {
  RUSAK
  SALAH_BARANG
  KURANG
}

enum FileKind {
  FOTO
  DOKUMEN
  VIDEO
  LAINNYA
}

enum RequirementStatus {
  DIBUTUHKAN
  DIRESERVE
  DIMINTA
  DIPESAN
  DITERIMA
  DIBATALKAN
}

enum NotifKind {
  APPROVAL
  STOK
  PENGIRIMAN
  LEAD
  TUGAS
  SURAT
  LAINNYA
}

// ─────────────────────────────── Fondasi ───────────────────────────────

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  name         String
  phone        String?
  position     String?
  department   String?
  role         Role
  status       ActiveStatus @default(AKTIF)
  warehouseId  Int?
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens         RefreshToken[]
  files                 File[]                  @relation("FileUploader")
  notifications         Notification[]
  ownedLeads            Lead[]                  @relation("LeadOwner")
  followUps             FollowUp[]
  surveysReq            Survey[]                @relation("SurveyRequester")
  surveysApprove        Survey[]                @relation("SurveyApprover")
  surveyMembers         SurveyMember[]
  quotations            Quotation[]             @relation("QuotationOwner")
  quoteVersions         QuotationVersion[]
  projects              Project[]               @relation("ProjectPic")
  projectMembers        ProjectMember[]
  tasks                 Task[]                  @relation("TaskAssignee")
  expenses              Expense[]               @relation("ExpenseReporter")
  pocReports            PocReport[]             @relation("PocOwner")
  pocMembers            PocMember[]
  visitReports          VisitReport[]           @relation("VisitOwner")
  visitMembers          VisitMember[]
  maintenanceReports    MaintenanceReport[]     @relation("MaintenanceOwner")
  maintenanceCreated    MaintenanceReport[]     @relation("MaintenanceCreator")
  maintenanceMembers    MaintenanceMember[]
  maintenanceActions    MaintenanceActionItem[] @relation("MaintenanceActionAssignee")
  calendarCreated       CalendarEvent[]         @relation("CalendarCreator")
  calendarAssigned      CalendarEvent[]         @relation("CalendarAssignee")
  calendarAttendees     CalendarAttendee[]
  createdDN             DeliveryNote[]          @relation("DNCreator")
  movements             StockMovement[]
  serialHist            SerialUnitHistory[]
  opnames               StockOpname[]
  receivings            Receiving[]
  purchases             PurchaseRequest[]       @relation("PRRequester")
  supplierPOs           SupplierPO[]            @relation("POCreator")
  approvalsReq          Approval[]              @relation("ApprovalRequester")
  damageReports         DamageReport[]
  issueReports          IssueReport[]
  auditAsActor          AuditLog[]              @relation("AuditActor")
  settings              SystemSetting[]
  attendances           Attendance[]            @relation("AttendanceUser")
  payrollSlips          PayrollSlip[]           @relation("PayrollSlipUser")
  salaryConfig          SalaryConfig?           @relation("SalaryConfigUser")
  employeeProfile       EmployeeProfile?        @relation("EmployeeProfileUser")
  paymentsCreated       Payment[]               @relation("PaymentCreator")
  approvalDecisions     ApprovalStep[]          @relation("ApprovalStepDecider")
  expensesPaid          Expense[]               @relation("ExpensePayer")
  deliveryNotesReceived DeliveryNote[]          @relation("DNReceiver")
  deliveryNotesSent     DeliveryNote[]          @relation("DNSender")
  deliveryNotesIssued   DeliveryNote[]          @relation("DNWarehouseStaff")
  deliveryNotesToPm     DeliveryNote[]          @relation("DNRecipient")
  pocCreated            PocReport[]             @relation("PocCreator")
  visitsCreated         VisitReport[]           @relation("VisitCreator")
  visitActions          VisitActionItem[]       @relation("VisitActionAssignee")
  pocChecklists         PocChecklist[]          @relation("PocChecklistAssignee")
  cashAdvancesHeld      CashAdvance[]           @relation("CashAdvanceEmployee")
  cashAdvancesRequested CashAdvance[]           @relation("CashAdvanceRequester")
  cashAdvancesApproved  CashAdvance[]           @relation("CashAdvanceApprover")
  cashAdvancesDisbursed CashAdvance[]           @relation("CashAdvanceDisburser")
  cashAdvancesSettled   CashAdvance[]           @relation("CashAdvanceSettler")
  assignedAssets        FaAsset[]               @relation("FaAssetAssignedUser")
  assetAssignments      FaAssetAssignment[]     @relation("FaAssignmentUser")
  maintPlansPic          MaintPlan[]             @relation("MaintPlanPic")
  maintSchedulesAssigned MaintSchedule[]         @relation("MaintScheduleAssigned")
  maintRequestsReported  MaintRequest[]          @relation("MaintRequestReporter")
  maintRequestsInspected MaintRequest[]          @relation("MaintRequestInspector")
  maintWorkOrdersAssigned MaintWorkOrder[]        @relation("MaintWOAssigned")
  maintWorkOrdersVerified MaintWorkOrder[]        @relation("MaintWOVerifier")
  maintWorkOrdersClosed  MaintWorkOrder[]        @relation("MaintWOCloser")
  maintLaborItems        MaintLabor[]            @relation("MaintLaborTechnician")
  maintApprovals         MaintApproval[]         @relation("MaintApprovalUser")
  maintNotifications     MaintNotification[]     @relation("MaintNotificationRecipient")

  @@index([role, status])
  @@index([warehouseId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model File {
  id           Int      @id @default(autoincrement())
  path         String
  originalName String
  mimeType     String
  size         Int
  kind         FileKind @default(LAINNYA)
  refType      String?
  refId        String?
  uploadedById Int?
  uploader     User?    @relation("FileUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  docPhotos                        DocumentationPhoto[]
  purchaseRequest_evidenceFile     PurchaseRequest[]    @relation("PurchaseRequest_evidenceFileId")
  purchaseRequest_doFile           PurchaseRequest[]    @relation("PurchaseRequest_doFileId")
  purchaseRequest_paymentProofFile PurchaseRequest[]    @relation("PurchaseRequest_paymentProofFileId")
  supplierPO_file                  SupplierPO[]         @relation("SupplierPO_fileId")
  supplierPO_doFile                SupplierPO[]         @relation("SupplierPO_doFileId")
  supplierPO_soFile                SupplierPO[]         @relation("SupplierPO_soFileId")
  receiving_receiptFile            Receiving[]          @relation("Receiving_receiptFileId")
  receiving_photoFile              Receiving[]          @relation("Receiving_photoFileId")
  invoiceIn_file                   InvoiceIn[]          @relation("InvoiceIn_fileId")
  invoiceIn_transferFile           InvoiceIn[]          @relation("InvoiceIn_transferFileId")
  invoiceIn_taxInvoiceFile         InvoiceIn[]          @relation("InvoiceIn_taxInvoiceFileId")
  invoiceOut_file                  InvoiceOut[]         @relation("InvoiceOut_fileId")
  invoiceOut_paidFile              InvoiceOut[]         @relation("InvoiceOut_paidFileId")
  invoiceOut_latestFile            InvoiceOut[]         @relation("InvoiceOut_latestFileId")
  payment_file                     Payment[]            @relation("Payment_fileId")
  clientPO_file                    ClientPO[]           @relation("ClientPO_fileId")
  clientPO_soFile                  ClientPO[]           @relation("ClientPO_soFileId")
  clientPO_paymentProofFile        ClientPO[]           @relation("ClientPO_paymentProofFileId")
  expense_receiptFile              Expense[]            @relation("Expense_receiptFileId")
  expense_paidFile                 Expense[]            @relation("Expense_paidFileId")
  project_prdFile                  Project[]            @relation("Project_prdFileId")
  project_bahpFile                 Project[]            @relation("Project_bahpFileId")
  project_bastFile                 Project[]            @relation("Project_bastFileId")
  project_doFile                   Project[]            @relation("Project_doFileId")
  project_boqFile                  Project[]            @relation("Project_boqFileId")
  task_bahpFile                    Task[]               @relation("Task_bahpFileId")
  task_bastFile                    Task[]               @relation("Task_bastFileId")
  task_doFile                      Task[]               @relation("Task_doFileId")
  quotation_latestFile             Quotation[]          @relation("Quotation_latestFileId")
  quotationVersion_file            QuotationVersion[]   @relation("QuotationVersion_fileId")
  issueReport_file                 IssueReport[]        @relation("IssueReport_fileId")
  damageReport_file                DamageReport[]       @relation("DamageReport_fileId")
  deliveryNote_scanFile            DeliveryNote[]       @relation("DeliveryNote_scanFileId")
  deliveryNote_reportFile          DeliveryNote[]       @relation("DeliveryNote_reportFileId")
  pocReport_logoFile               PocReport[]          @relation("PocReport_logoFileId")
  pocReport_documentFile           PocReport[]          @relation("PocReport_documentFileId")
  visitReport_logoFile             VisitReport[]        @relation("VisitReport_logoFileId")
  visitReport_documentFile         VisitReport[]        @relation("VisitReport_documentFileId")
  maintenanceReport_logoFile       MaintenanceReport[]  @relation("MaintenanceReport_logoFileId")
  maintenanceReport_documentFile   MaintenanceReport[]  @relation("MaintenanceReport_documentFileId")
  cashAdvance_disburseFile         CashAdvance[]        @relation("CashAdvance_disburseFileId")
  cashAdvance_returnFile           CashAdvance[]        @relation("CashAdvance_returnFileId")

  @@index([refType, refId])
}

/// Foto dokumentasi berfoto (survey, instalasi/project, surat jalan) + caption.
model DocumentationPhoto {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  fileId     Int
  file       File     @relation(fields: [fileId], references: [id])
  caption    String?
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, fileId])
  @@index([entityType, entityId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorName  String
  action     String
  entityType String
  entityId   String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole Role?
  kind       NotifKind @default(LAINNYA)
  text       String
  href       String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, read])
  @@index([targetRole, read])
  @@index([createdAt])
}

model DocumentNumber {
  id      Int    @id @default(autoincrement())
  docType String
  period  String
  seq     Int    @default(0)

  @@unique([docType, period])
}

model SystemSetting {
  key         String   @id
  value       String   @db.LongText
  description String?
  updatedById Int?
  updatedAt   DateTime @updatedAt

  updater User? @relation(fields: [updatedById], references: [id])
}

model Approval {
  id            Int            @id @default(autoincrement())
  kind          ApprovalKind
  entityId      Int
  title         String
  amount        Decimal        @default(0) @db.Decimal(18, 2)
  requestedById Int
  requested_by  User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  status        ApprovalStatus @default(MENUNGGU)
  reason        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  steps ApprovalStep[]

  @@unique([kind, entityId])
  @@index([status])
}

model ApprovalStep {
  id           Int            @id @default(autoincrement())
  approvalId   Int
  approval     Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approverRole Role
  status       ApprovalStatus @default(MENUNGGU)
  decidedById  Int?
  decidedBy    User?          @relation("ApprovalStepDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  reason       String?

  @@unique([approvalId, approverRole])
  @@index([approverRole, status])
}

// ─────────────────────────────── Master data ───────────────────────────────

model Customer {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  company   String?
  pic       String
  email     String?
  phone     String?
  address   String?
  city      String?
  notes     String?
  status    ActiveStatus @default(AKTIF)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leads              Lead[]
  projects           Project[]
  quotations         Quotation[]
  clientPOs          ClientPO[]
  invoices           InvoiceOut[]
  pocReports         PocReport[]
  visitReports       VisitReport[]
  maintenanceReports MaintenanceReport[]
  calendarEvents     CalendarEvent[]     @relation("CalendarCustomer")

  @@index([status])
}

model Supplier {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  pic          String?
  email        String?
  phone        String?
  city         String?
  paymentTerms String?
  notes        String?
  status       ActiveStatus @default(AKTIF)
  taxStatus    String?      @default("NON_PKP")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  itemTags         SupplierItemTag[]
  purchaseRequests PurchaseRequest[]
  supplierPOs      SupplierPO[]
  clientPOs        ClientPO[]
  invoiceIns       InvoiceIn[]
  calendarEvents   CalendarEvent[]   @relation("CalendarSupplier")
}

model SupplierItemTag {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemName   String
  price      Decimal? @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@index([itemName])
}

model ProductCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  prefix      String?
  status      ActiveStatus @default(AKTIF)

  products Product[]
}

model Product {
  id             Int              @id @default(autoincrement())
  sku            String           @unique
  name           String
  brand          String?
  description    String?          @db.Text
  type           String?
  categoryId     Int?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  unit           String
  hasSerial      Boolean          @default(false)
  minStock       Int              @default(0)
  warrantyMonths Int?
  purchasePrice  Decimal          @default(0) @db.Decimal(18, 2)
  avgCost        Decimal          @default(0) @db.Decimal(18, 4)
  status         ActiveStatus     @default(AKTIF)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  balances          StockBalance[]
  movements         StockMovement[]
  serials           SerialUnit[]
  reservations      StockReservation[]
  prItems           PurchaseRequestItem[]
  poItems           SupplierPOItem[]
  receivingItems    ReceivingItem[]
  maintMaterials    MaintMaterial[]
  opnameDetails     StockOpnameDetail[]
  requirements      ProjectRequirement[]
  damageReports     DamageReport[]
  issueReports      IssueReport[]
  deliveryNoteItems DeliveryNoteItem[]

  @@index([name])
  @@index([categoryId])
}

model Warehouse {
  id        Int          @id @default(autoincrement())
  name      String
  city      String?
  status    ActiveStatus @default(AKTIF)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         User[]
  balances      StockBalance[]
  fromMovements StockMovement[]     @relation("MoveFrom")
  toMovements   StockMovement[]     @relation("MoveTo")
  serials       SerialUnit[]
  receivings    Receiving[]
  opnames       StockOpname[]
  serialHistory SerialUnitHistory[] @relation("SerialHistWarehouse")
  deliveryNotes DeliveryNote[]

  @@index([name])
}

model LeadSource {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  status ActiveStatus @default(AKTIF)
  leads  Lead[]
}

model LostReason {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  status ActiveStatus @default(AKTIF)
  leads  Lead[]
}

model VisitActivityType {
  id     Int           @id @default(autoincrement())
  name   String        @unique
  status ActiveStatus  @default(AKTIF)
  visits VisitReport[]
}

model ExpenseCategory {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  coaAccount       String?
  status           ActiveStatus      @default(AKTIF)
  expenses         Expense[]
  cashAdvanceItems CashAdvanceItem[]
}

model CostCenter {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  status   ActiveStatus @default(AKTIF)
  expenses Expense[]
}

// ─────────────────────────────── Sales CRM ───────────────────────────────

model Lead {
  id             Int         @id @default(autoincrement())
  name           String
  customerId     Int?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  sourceId       Int?
  source         LeadSource? @relation(fields: [sourceId], references: [id])
  clientType     ClientType  @default(END_USER)
  need           String?
  contactName    String?
  estimatedValue Decimal?    @db.Decimal(18, 2)
  probability    Int         @default(20)
  targetClosing  DateTime?   @db.Date
  owner_id       Int
  owner          User        @relation("LeadOwner", fields: [owner_id], references: [id])
  stage          LeadStage   @default(PROSPECTING)
  lostReasonId   Int?
  lostReason     LostReason? @relation(fields: [lostReasonId], references: [id])
  lostNote       String?
  needsSurvey    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  followUps          FollowUp[]
  surveys            Survey[]
  quotations         Quotation[]
  pocReports         PocReport[]
  visitReports       VisitReport[]
  maintenanceReports MaintenanceReport[]
  calendarEvents     CalendarEvent[]     @relation("CalendarLead")

  @@index([stage])
  @@index([owner_id])
  @@index([customerId])
  @@index([targetClosing])
}

model FollowUp {
  id                  Int                @id @default(autoincrement())
  leadId              Int?
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationId         Int?
  pocReportId         Int?
  pocReport           PocReport?         @relation(fields: [pocReportId], references: [id], onDelete: Cascade)
  visitReportId       Int?
  visitReport         VisitReport?       @relation(fields: [visitReportId], references: [id], onDelete: Cascade)
  maintenanceReportId Int?
  maintenanceReport   MaintenanceReport? @relation(fields: [maintenanceReportId], references: [id], onDelete: Cascade)
  date                DateTime           @db.Date
  method              FollowUpMethod
  notes               String
  nextDate            DateTime?          @db.Date
  status              FollowUpStatus     @default(SELESAI)
  createdById         Int?
  creator             User?              @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  quotation           Quotation?         @relation(fields: [quotationId], references: [id])

  @@index([leadId])
  @@index([quotationId])
  @@index([pocReportId])
  @@index([visitReportId])
  @@index([maintenanceReportId])
  @@index([date])
}

model Survey {
  id             Int          @id @default(autoincrement())
  leadId         Int
  lead           Lead         @relation(fields: [leadId], references: [id])
  location       String
  need           String?
  notes          String?
  scheduleAt     DateTime?
  status         SurveyStatus @default(DIMINTA)
  cost           Decimal      @default(0) @db.Decimal(18, 2)
  requestedById  Int
  requester      User         @relation("SurveyRequester", fields: [requestedById], references: [id])
  approvedById   Int?
  approver       User?        @relation("SurveyApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members      SurveyMember[]
  expenses     Expense[]
  cashAdvances CashAdvance[]

  @@index([status])
  @@index([scheduleAt])
  @@index([leadId])
}

model SurveyMember {
  id       Int    @id @default(autoincrement())
  surveyId Int
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id])

  @@unique([surveyId, userId])
}

// ─────────────────────────────── Penawaran ───────────────────────────────

model Quotation {
  id             Int             @id @default(autoincrement())
  number         String          @unique
  leadId         Int?
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId     Int?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  ownerId        Int
  owner          User            @relation("QuotationOwner", fields: [ownerId], references: [id])
  status         QuotationStatus @default(NOT_YET)
  validUntil     DateTime?       @db.Date
  currentVersion Int             @default(0)
  total          Decimal         @default(0) @db.Decimal(18, 2)
  ppn            Decimal         @default(0) @db.Decimal(18, 2)
  discount       Decimal         @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal         @default(0) @db.Decimal(18, 2)
  sentAt         DateTime?

  // Isi & template penawaran (dulu JSON di SystemSetting "quotation.meta.<id>")
  items                Json?
  subject              String?
  intro                String?          @db.Text
  // Catatan kaki. Null = pakai catatan bawaan.
  notes                Json?
  city                 String?
  kopText              String?          @db.Text
  customerAddress      String?          @db.Text
  signerName           String?
  signerTitle          String?
  pph                  Decimal?         @db.Decimal(18, 2)
  pphMode              String?
  tipePph              String?
  // Berkas terakhir yang dihasilkan / diunggah
  latestFileId         Int?
  latestFile           File?            @relation("Quotation_latestFileId", fields: [latestFileId], references: [id], onDelete: SetNull)
  latestFileName       String?
  // Konflik stok / auto-swap SN
  stockConflictFlag    Boolean          @default(false)
  stockConflictMessage String?          @db.Text
  autoSwapLogs         Json?
  emergencyPrId        Int?
  emergencyPr          PurchaseRequest? @relation("QuotationEmergencyPr", fields: [emergencyPrId], references: [id], onDelete: SetNull)
  emergencyPrNumber    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  versions     QuotationVersion[]
  clientPOs    ClientPO[]
  invoices     InvoiceOut[]
  followUps    FollowUp[]
  projects     Project[]
  reservations StockReservation[]

  @@index([status])
  @@index([leadId])
  @@index([ownerId])
}

model QuotationVersion {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version     Int
  fileId      Int?
  file        File?     @relation("QuotationVersion_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  total       Decimal   @default(0) @db.Decimal(18, 2)
  ppn         Decimal   @default(0) @db.Decimal(18, 2)
  discount    Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal  Decimal   @default(0) @db.Decimal(18, 2)
  note        String?
  createdById Int?
  creator     User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([quotationId, version])
}

// ─────────────────────────────── Finance ───────────────────────────────

model ClientPO {
  id          Int        @id @default(autoincrement())
  number      String     @unique
  customerId  Int?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  supplierId  Int?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  amount      Decimal    @db.Decimal(18, 2)
  date        DateTime   @db.Date
  fileId      Int?
  file        File?      @relation("ClientPO_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  notes       String?

  // Metadata Sales Order (dulu JSON di SystemSetting "client-po:meta:<id>")
  // Nomor SO / nomor PO dari customer; "number" tetap nomor utama dokumen.
  soNumber           String?
  poClientNumber     String?
  docMode            String? // SO | PO | BOTH
  soFileId           Int?
  soFile             File?     @relation("ClientPO_soFileId", fields: [soFileId], references: [id], onDelete: SetNull)
  items              Json?
  projectId          Int?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ppn                Decimal?  @db.Decimal(18, 2)
  tipePpn            String?
  ppnMode            String?
  pph                Decimal?  @db.Decimal(18, 2)
  tipePph            String?
  pphMode            String?
  // Pelunasan langsung (tanpa invoice)
  paymentStatus      String? // PENDING | LUNAS
  settlementType     String? // LANGSUNG | TEMPO
  paymentProofFileId Int?
  paymentProofFile   File?     @relation("ClientPO_paymentProofFileId", fields: [paymentProofFileId], references: [id], onDelete: SetNull)
  coaAccount         String?
  settledAt          DateTime?
  goodsDispatched    Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invoices      InvoiceOut[]
  deliveryNotes DeliveryNote[]

  @@index([customerId])
  @@index([supplierId])
  @@index([date])
  @@index([projectId])
}

model InvoiceOut {
  id          Int              @id @default(autoincrement())
  number      String           @unique
  clientPoId  Int?
  clientPo    ClientPO?        @relation(fields: [clientPoId], references: [id])
  projectId   Int?
  project     Project?         @relation(fields: [projectId], references: [id])
  customerId  Int?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description String?
  type        InvoiceType      @default(TERMIN)
  // Proforma invoice: penagihan awal / penawaran tagihan. TIDAK dijurnal, tidak masuk piutang,
  // tidak bisa dibayar langsung. Diterbitkan menjadi invoice resmi lewat konversi (proformaId di invoice resmi).
  isProforma  Boolean          @default(false)
  proformaId  Int?             @unique
  proforma    InvoiceOut?      @relation("ProformaConversion", fields: [proformaId], references: [id], onDelete: SetNull)
  amount      Decimal          @db.Decimal(18, 2)
  ppn         Decimal          @default(0) @db.Decimal(18, 2)
  total       Decimal          @db.Decimal(18, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(18, 2)
  date        DateTime         @db.Date
  dueDate     DateTime         @db.Date
  status      InvoiceOutStatus @default(DRAFT)
  fileId      Int?
  file        File?            @relation("InvoiceOut_fileId", fields: [fileId], references: [id], onDelete: SetNull)

  // Metadata invoice (dulu JSON di SystemSetting "invoice:meta:<id>")
  quotationId          Int?
  quotation            Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  parentInvoiceId      Int?
  parentInvoice        InvoiceOut?      @relation("InvoiceContinuation", fields: [parentInvoiceId], references: [id], onDelete: SetNull)
  isContinuation       Boolean          @default(false)
  discount             Decimal?         @db.Decimal(18, 2)
  dpLabel              String?
  dpAmount             Decimal?         @db.Decimal(18, 2)
  dpApplied            Decimal          @default(0) @db.Decimal(18, 2)
  retentionPercent     Decimal?         @db.Decimal(5, 2)
  retentionAmount      Decimal?         @db.Decimal(18, 2)
  pph                  Decimal?         @db.Decimal(18, 2)
  pphMode              String?
  tipePph              String?
  tipePpn              String?
  ppnMode              String?
  coaAccount           String?
  // Berkas bukti bayar. Bila ada baris Payment, berkas Payment terbaru yang dipakai.
  paidFileId           Int?
  paidFile             File?            @relation("InvoiceOut_paidFileId", fields: [paidFileId], references: [id], onDelete: SetNull)
  // Tampilan dokumen (kop, penandatangan, teks)
  subject              String?
  intro                String?          @db.Text
  city                 String?
  kopText              String?          @db.Text
  kopLogoUrl           String?          @db.LongText
  customerAddress      String?          @db.Text
  signerName           String?
  signerTitle          String?
  notesList            Json?
  items                Json?
  // Konflik stok / auto-swap SN
  stockConflictFlag    Boolean          @default(false)
  stockConflictMessage String?          @db.Text
  autoSwapLogs         Json?
  emergencyPrId        Int?
  emergencyPr          PurchaseRequest? @relation("InvoiceEmergencyPr", fields: [emergencyPrId], references: [id], onDelete: SetNull)
  emergencyPrNumber    String?
  latestFileId         Int?
  latestFile           File?            @relation("InvoiceOut_latestFileId", fields: [latestFileId], references: [id], onDelete: SetNull)
  latestFileName       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  payments       Payment[]
  reservations   StockReservation[]
  continuations  InvoiceOut[]       @relation("InvoiceContinuation")
  convertedTo    InvoiceOut?        @relation("ProformaConversion")
  calendarEvents CalendarEvent[]    @relation("CalendarInvoice")
  deliveryNotes  DeliveryNote[]

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
  @@index([projectId])
  @@index([quotationId])
  @@index([isProforma])
}

model InvoiceIn {
  id               Int             @id @default(autoincrement())
  number           String?
  supplierId       Int
  supplier         Supplier        @relation(fields: [supplierId], references: [id])
  supplierPoId     Int?
  supplierPo       SupplierPO?     @relation(fields: [supplierPoId], references: [id])
  amount           Decimal         @db.Decimal(18, 2)
  ppn              Decimal         @default(0) @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(18, 2)
  dueDate          DateTime        @db.Date
  status           InvoiceInStatus @default(UNPAID)
  fileId           Int?
  file             File?           @relation("InvoiceIn_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  transferFileId   Int?
  transferFile     File?           @relation("InvoiceIn_transferFileId", fields: [transferFileId], references: [id], onDelete: SetNull)
  /// Faktur pajak (e-Faktur) dari supplier — dasar mengkreditkan PPN Masukan
  taxInvoiceFileId Int?
  taxInvoiceFile   File?           @relation("InvoiceIn_taxInvoiceFileId", fields: [taxInvoiceFileId], references: [id], onDelete: SetNull)
  /// Nomor seri faktur pajak (NSFP)
  taxInvoiceNumber String?

  // Metadata (dulu JSON di SystemSetting "invoice-in:meta:<id>"). Berkas tetap di fileId / transferFileId.
  notes        String?   @db.Text
  category     String?
  debitAccount String?
  date         DateTime? @db.Date
  items        Json?
  coaAccount   String?
  pph          Decimal?  @db.Decimal(18, 2)
  pphMode      String?
  tipePph      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments Payment[]

  @@unique([supplierId, number])
  @@index([status])
  @@index([dueDate])
  @@index([supplierId])
}

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceOutId Int?
  invoiceOut   InvoiceOut?   @relation(fields: [invoiceOutId], references: [id])
  invoiceInId  Int?
  invoiceIn    InvoiceIn?    @relation(fields: [invoiceInId], references: [id])
  amount       Decimal       @db.Decimal(18, 2)
  date         DateTime      @db.Date
  method       PaymentMethod @default(TRANSFER)
  accountCode  String?
  reference    String?
  fileId       Int?
  file         File?         @relation("Payment_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  createdById  Int?
  creator      User?         @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([invoiceOutId])
  @@index([invoiceInId])
}

model Expense {
  id                  Int                @id @default(autoincrement())
  date                DateTime           @db.Date
  reporterId          Int
  reporter            User               @relation("ExpenseReporter", fields: [reporterId], references: [id])
  categoryId          Int?
  category            ExpenseCategory?   @relation(fields: [categoryId], references: [id])
  amount              Decimal            @db.Decimal(18, 2)
  description         String
  status              ExpenseStatus      @default(DILAPORKAN)
  projectId           Int?
  project             Project?           @relation(fields: [projectId], references: [id])
  surveyId            Int?
  survey              Survey?            @relation(fields: [surveyId], references: [id])
  deliveryNoteId      Int?
  deliveryNote        DeliveryNote?      @relation(fields: [deliveryNoteId], references: [id])
  pocReportId         Int?
  pocReport           PocReport?         @relation(fields: [pocReportId], references: [id])
  visitReportId       Int?
  visitReport         VisitReport?       @relation(fields: [visitReportId], references: [id])
  maintenanceReportId Int?
  maintenanceReport   MaintenanceReport? @relation(fields: [maintenanceReportId], references: [id])
  costCenterId        Int?
  costCenter          CostCenter?        @relation(fields: [costCenterId], references: [id])
  receiptFileId       Int?
  receiptFile         File?              @relation("Expense_receiptFileId", fields: [receiptFileId], references: [id], onDelete: SetNull)
  receiptFileIds      String?            @db.Text
  paidFileId          Int?
  paidFile            File?              @relation("Expense_paidFileId", fields: [paidFileId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  rejectReason        String?
  fundingSource       String             @default("PERUSAHAAN")
  reimbursementStatus String?
  paymentMethod       String?
  approvedAmount      Decimal?           @db.Decimal(18, 2)
  paidAmount          Decimal?           @db.Decimal(18, 2)
  paidAccountCode     String?
  paidById            Int?
  paidBy              User?              @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  // Biaya yang dibayar dari uang jalan (jurnalnya mengurangi Uang Muka Karyawan, bukan hutang reimbursement)
  cashAdvanceId       Int?
  cashAdvance         CashAdvance?       @relation(fields: [cashAdvanceId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([reporterId])
  @@index([date])
  @@index([projectId])
  @@index([surveyId])
  @@index([pocReportId])
  @@index([visitReportId])
  @@index([maintenanceReportId])
  @@index([deliveryNoteId])
  @@index([cashAdvanceId])
}

// ─────────────────────────────── Uang Jalan ───────────────────────────────

/// Uang jalan / kasbon: diajukan karyawan, disetujui & dicairkan Finance (masuk "kantong" karyawan =
/// Uang Muka Karyawan), lalu karyawan melaporkan biayanya. Saat laporan diverifikasi, biaya diakui &
/// sisa dikembalikan ke kas (atau kelebihan dibayar perusahaan).
model CashAdvance {
  id                  Int                @id @default(autoincrement())
  number              String             @unique
  purpose             CashAdvancePurpose @default(LAINNYA)
  description         String             @db.Text
  surveyId            Int?
  survey              Survey?            @relation(fields: [surveyId], references: [id], onDelete: SetNull)
  deliveryNoteId      Int?
  deliveryNote        DeliveryNote?      @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)
  projectId           Int?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Karyawan pemegang uang (yang berangkat survey / admin gudang / kurir)
  employeeId          Int
  employee            User               @relation("CashAdvanceEmployee", fields: [employeeId], references: [id])
  requestedById       Int
  requestedBy         User               @relation("CashAdvanceRequester", fields: [requestedById], references: [id])
  amount              Decimal            @db.Decimal(18, 2)
  neededDate          DateTime?          @db.Date
  status              CashAdvanceStatus  @default(DIAJUKAN)
  // Persetujuan
  approvedAmount      Decimal?           @db.Decimal(18, 2)
  approvedById        Int?
  approvedBy          User?              @relation("CashAdvanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  rejectReason        String?            @db.Text
  // Pencairan (kas keluar)
  disbursedAmount     Decimal?           @db.Decimal(18, 2)
  disbursedAt         DateTime?          @db.Date
  disburseAccountCode String?
  disburseMethod      String?
  disburseFileId      Int?
  disburseFile        File?              @relation("CashAdvance_disburseFileId", fields: [disburseFileId], references: [id], onDelete: SetNull)
  disbursedById       Int?
  disbursedBy         User?              @relation("CashAdvanceDisburser", fields: [disbursedById], references: [id], onDelete: SetNull)
  // Laporan & penyelesaian
  reportedAt          DateTime?
  reportNote          String?            @db.Text
  settledAt           DateTime?
  settledById         Int?
  settledBy           User?              @relation("CashAdvanceSettler", fields: [settledById], references: [id], onDelete: SetNull)
  spentAmount         Decimal?           @db.Decimal(18, 2)
  returnedAmount      Decimal?           @db.Decimal(18, 2)
  returnAccountCode   String?
  returnFileId        Int?
  returnFile          File?              @relation("CashAdvance_returnFileId", fields: [returnFileId], references: [id], onDelete: SetNull)
  reimbursedAmount    Decimal?           @db.Decimal(18, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items    CashAdvanceItem[]
  expenses Expense[]

  @@index([status])
  @@index([employeeId])
  @@index([surveyId])
  @@index([deliveryNoteId])
  @@index([projectId])
}

/// Rincian biaya yang dilaporkan dari uang jalan (bensin, tol, parkir, makan, dll.) + foto nota.
model CashAdvanceItem {
  id             Int              @id @default(autoincrement())
  cashAdvanceId  Int
  cashAdvance    CashAdvance      @relation(fields: [cashAdvanceId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  description    String
  amount         Decimal          @db.Decimal(18, 2)
  categoryId     Int?
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receiptFileIds Json?
  createdAt      DateTime         @default(now())

  @@index([cashAdvanceId])
}

// ─────────────────────────────── Project ───────────────────────────────

model Project {
  id            Int           @id @default(autoincrement())
  name          String
  type          ProjectType   @default(CUSTOMER)
  customerId    Int?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  picId         Int
  pic           User          @relation("ProjectPic", fields: [picId], references: [id])
  quotationId   Int?
  quotation     Quotation?    @relation(fields: [quotationId], references: [id])
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  status        ProjectStatus @default(BERJALAN)
  progress      Int           @default(0)
  paymentStatus PaymentStatus @default(BELUM_LUNAS)
  prdFileId     Int?
  prdFile       File?         @relation("Project_prdFileId", fields: [prdFileId], references: [id], onDelete: SetNull)
  bahpFileId    Int?
  bahpFile      File?         @relation("Project_bahpFileId", fields: [bahpFileId], references: [id], onDelete: SetNull)
  bastFileId    Int?
  bastFile      File?         @relation("Project_bastFileId", fields: [bastFileId], references: [id], onDelete: SetNull)
  doFileId      Int?
  doFile        File?         @relation("Project_doFileId", fields: [doFileId], references: [id], onDelete: SetNull)
  boqFileId     Int?
  boqFile       File?         @relation("Project_boqFileId", fields: [boqFileId], references: [id], onDelete: SetNull)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members            ProjectMember[]
  tasks              Task[]
  requirements       ProjectRequirement[]
  reservations       StockReservation[]
  movements          StockMovement[]
  invoices           InvoiceOut[]
  expenses           Expense[]
  pocReports         PocReport[]
  visitReports       VisitReport[]
  maintenanceReports MaintenanceReport[]
  dnLocations        DeliveryNoteLocation[]
  purchaseRequests   PurchaseRequest[]
  serialUnits        SerialUnit[]
  supplierPOs        SupplierPO[]
  receivings         Receiving[]
  serialHistory      SerialUnitHistory[]    @relation("SerialHistProject")
  calendarEvents     CalendarEvent[]        @relation("CalendarProject")
  clientPOs          ClientPO[]
  cashAdvances       CashAdvance[]

  @@index([status])
  @@index([picId])
  @@index([customerId])
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Task {
  id            Int        @id @default(autoincrement())
  projectId     Int
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId      Int?
  parent        Task?      @relation("TaskTree", fields: [parentId], references: [id])
  children      Task[]     @relation("TaskTree")
  name          String
  description   String?    @db.Text
  assigneeId    Int?
  assignee      User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate       DateTime?  @db.Date
  priority      Priority   @default(SEDANG)
  status        TaskStatus @default(TODO)
  progress      Int        @default(0)
  needsPurchase Boolean    @default(false)
  bahpFileId    Int?
  bahpFile      File?      @relation("Task_bahpFileId", fields: [bahpFileId], references: [id], onDelete: SetNull)
  bastFileId    Int?
  bastFile      File?      @relation("Task_bastFileId", fields: [bastFileId], references: [id], onDelete: SetNull)
  doFileId      Int?
  doFile        File?      @relation("Task_doFileId", fields: [doFileId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  requirements     ProjectRequirement[]
  purchaseRequests PurchaseRequest[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model ProjectRequirement {
  id           Int                @id @default(autoincrement())
  projectId    Int
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       Int?
  task         Task?              @relation(fields: [taskId], references: [id])
  productId    Int
  product      Product            @relation(fields: [productId], references: [id])
  qty          Int
  reservedQty  Int                @default(0)
  serials      String?            @db.LongText
  status       RequirementStatus  @default(DIBUTUHKAN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  reservations StockReservation[] @relation("ReservationRequirement")

  @@index([projectId])
  @@index([productId])
}

// ─────────────────────────────── Procurement ───────────────────────────────

model PurchaseRequest {
  id                  Int                   @id @default(autoincrement())
  number              String                @unique
  date                DateTime              @db.Date
  requesterId         Int
  requester           User                  @relation("PRRequester", fields: [requesterId], references: [id])
  costType            CostType
  procurementSource   ProcurementSource     @default(SUPPLIER)
  paymentMethod       PurchasePaymentMethod @default(UTANG)
  // Mode PPN harga barang (dulu tag "[PPN:x]" di otherNote)
  ppnMode             PpnMode               @default(none)
  // Semua barang pakai-habis untuk proyek (dulu tag "[ALL_CONSUMABLES]" di otherNote)
  isProjectConsumable Boolean               @default(false)
  projectId           Int?
  project             Project?              @relation(fields: [projectId], references: [id])
  taskId              Int?
  task                Task?                 @relation(fields: [taskId], references: [id])
  supplierId          Int?
  supplier            Supplier?             @relation(fields: [supplierId], references: [id])
  condition           ItemCondition         @default(BARU)
  estimatedCost       Decimal               @default(0) @db.Decimal(18, 2)
  purpose             String
  otherNote           String?
  evidenceFileId      Int?
  evidenceFile        File?                 @relation("PurchaseRequest_evidenceFileId", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  doFileId            Int?
  doFile              File?                 @relation("PurchaseRequest_doFileId", fields: [doFileId], references: [id], onDelete: SetNull)
  paymentProofFileId  Int?
  paymentProofFile    File?                 @relation("PurchaseRequest_paymentProofFileId", fields: [paymentProofFileId], references: [id], onDelete: SetNull)
  paymentStatus       PrPaymentStatus       @default(BELUM_DIBAYAR)
  // Kode akun kas/bank sumber pembayaran (mis. 1000.01). Satu-satunya tempat; dulu disisipkan sebagai tag di otherNote.
  paymentAccountCode  String?
  dueDate             DateTime?             @db.Date
  status              PrStatus              @default(DIAJUKAN)
  rejectReason        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  items               PurchaseRequestItem[]
  supplierPOs         SupplierPO[]
  reservations        StockReservation[]
  receivings          Receiving[]
  emergencyQuotations Quotation[]           @relation("QuotationEmergencyPr")
  emergencyInvoices   InvoiceOut[]          @relation("InvoiceEmergencyPr")

  @@index([status])
  @@index([projectId])
  @@index([date])
  @@index([dueDate])
}

model PurchaseRequestItem {
  id           Int             @id @default(autoincrement())
  requestId    Int
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product?        @relation(fields: [productId], references: [id])
  customName   String?
  customUnit   String?
  qty          Int
  unitCost     Decimal         @default(0) @db.Decimal(18, 2)
  serials      String?         @db.LongText
  // Barang pakai-habis proyek (dulu awalan "[PAKAI_HABIS]" di customName)
  isConsumable Boolean         @default(false)

  @@index([requestId])
}

model SupplierPO {
  id               Int              @id @default(autoincrement())
  number           String           @unique
  supplierId       Int
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  requestId        Int?
  request          PurchaseRequest? @relation(fields: [requestId], references: [id])
  projectId        Int?
  project          Project?         @relation(fields: [projectId], references: [id])
  date             DateTime         @db.Date
  eta              DateTime?        @db.Date
  paymentTerms     String?
  total            Decimal          @db.Decimal(18, 2)
  status           PoStatus         @default(MENUNGGU_PERSETUJUAN)
  shipmentStatus   ShipmentStatus   @default(DI_SUPPLIER)
  fileId           Int?
  file             File?            @relation("SupplierPO_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  doFileId         Int?
  doFile           File?            @relation("SupplierPO_doFileId", fields: [doFileId], references: [id], onDelete: SetNull)
  createdById      Int?
  creator          User?            @relation("POCreator", fields: [createdById], references: [id])
  arrivedAt        DateTime?
  // Metadata PO (dulu JSON di SystemSetting "supplier-po:meta:<id>")
  supplierSoNumber String?
  soFileId         Int?
  soFile           File?            @relation("SupplierPO_soFileId", fields: [soFileId], references: [id], onDelete: SetNull)
  // Penanda pembayaran manual dari Finance
  manualStatus     PoManualStatus?
  ppnMode          PpnMode?
  dpp              Decimal?         @db.Decimal(18, 2)
  ppn              Decimal?         @db.Decimal(18, 2)
  pphMode          String?
  tipePph          String?
  pph              Decimal?         @db.Decimal(18, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items      SupplierPOItem[]
  receivings Receiving[]
  invoiceIns InvoiceIn[]
  returns    DamageReport[]

  @@index([status])
  @@index([shipmentStatus])
  @@index([supplierId])
}

model SupplierPOItem {
  id          Int        @id @default(autoincrement())
  poId        Int
  po          SupplierPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?   @relation(fields: [productId], references: [id])
  customName  String?
  customUnit  String?
  qty         Int
  price       Decimal    @db.Decimal(18, 2)
  diskon      Decimal    @default(0) @db.Decimal(18, 2)
  diskonPct   Decimal?   @db.Decimal(5, 2)
  receivedQty Int        @default(0)

  @@index([poId])
}

model Receiving {
  id            Int              @id @default(autoincrement())
  number        String           @unique
  supplierPoId  Int?
  supplierPo    SupplierPO?      @relation(fields: [supplierPoId], references: [id])
  requestId     Int?
  request       PurchaseRequest? @relation(fields: [requestId], references: [id])
  supplierName  String?
  warehouseId   Int?
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])
  projectId     Int?
  project       Project?         @relation(fields: [projectId], references: [id])
  date          DateTime         @db.Date
  receiverId    Int
  receiver      User             @relation(fields: [receiverId], references: [id])
  status        ReceivingStatus  @default(MENUNGGU)
  conditionNote String?          @db.Text
  receiptFileId Int?
  receiptFile   File?            @relation("Receiving_receiptFileId", fields: [receiptFileId], references: [id], onDelete: SetNull)
  photoFileId   Int?
  photoFile     File?            @relation("Receiving_photoFileId", fields: [photoFileId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items        ReceivingItem[]
  issueReports IssueReport[]
  movements    StockMovement[] @relation("MovementReceiving")

  @@index([status])
  @@index([supplierPoId])
  @@index([requestId])
  @@index([warehouseId])
}

model ReceivingItem {
  id          Int       @id @default(autoincrement())
  receivingId Int
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  qtyOrdered  Int
  qtyReceived Int       @default(0)
  serials     String?   @db.LongText
  note        String?   @db.Text

  @@index([receivingId])
}

model IssueReport {
  id          Int          @id @default(autoincrement())
  receivingId Int?
  receiving   Receiving?   @relation(fields: [receivingId], references: [id])
  poNumber    String?
  productId   Int?
  product     Product?     @relation(fields: [productId], references: [id])
  type        IssueType
  qty         Int          @default(1)
  description String
  fileId      Int?
  file        File?        @relation("IssueReport_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  reporterId  Int
  reporter    User         @relation(fields: [reporterId], references: [id])
  status      DamageStatus @default(DILAPORKAN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([receivingId])
}

// ─────────────────────────────── Gudang ───────────────────────────────

model StockBalance {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qty         Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id              Int              @id @default(autoincrement())
  date            DateTime         @db.Date
  type            MovementType
  category        MovementCategory
  productId       Int
  product         Product          @relation(fields: [productId], references: [id])
  fromWarehouseId Int?
  fromWarehouse   Warehouse?       @relation("MoveFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   Int?
  toWarehouse     Warehouse?       @relation("MoveTo", fields: [toWarehouseId], references: [id])
  qty             Int
  unitCost        Decimal?         @db.Decimal(18, 4)
  totalCost       Decimal?         @db.Decimal(18, 2)
  serialUnitId    Int?
  serialUnit      SerialUnit?      @relation(fields: [serialUnitId], references: [id])
  projectId       Int?
  project         Project?         @relation(fields: [projectId], references: [id])
  deliveryNoteId  Int?
  deliveryNote    DeliveryNote?    @relation(fields: [deliveryNoteId], references: [id])
  receivingId     Int?
  receiving       Receiving?       @relation("MovementReceiving", fields: [receivingId], references: [id], onDelete: SetNull)
  reason          String?
  createdById     Int?
  creator         User?            @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())

  @@index([productId])
  @@index([date])
  @@index([type])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([deliveryNoteId])
}

model SerialUnit {
  id             Int          @id @default(autoincrement())
  sn             String       @unique
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  status         SerialStatus @default(DI_GUDANG)
  warehouseId    Int?
  warehouse      Warehouse?   @relation(fields: [warehouseId], references: [id])
  projectId      Int?
  project        Project?     @relation(fields: [projectId], references: [id])
  warrantyEndsAt DateTime?    @db.Date
  replacedFromId Int?
  replacedFrom   SerialUnit?  @relation("SerialReplacement", fields: [replacedFromId], references: [id])
  replacedBy     SerialUnit[] @relation("SerialReplacement")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  history       SerialUnitHistory[]
  movements     StockMovement[]
  reservations  StockReservation[]
  damageReports DamageReport[]

  @@index([status])
  @@index([warehouseId])
  @@index([productId])
}

model SerialUnitHistory {
  id           Int          @id @default(autoincrement())
  serialUnitId Int
  serialUnit   SerialUnit   @relation(fields: [serialUnitId], references: [id], onDelete: Cascade)
  status       SerialStatus
  warehouseId  Int?
  warehouse    Warehouse?   @relation("SerialHistWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  projectId    Int?
  project      Project?     @relation("SerialHistProject", fields: [projectId], references: [id], onDelete: SetNull)
  note         String?
  changedById  Int?
  changer      User?        @relation(fields: [changedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([serialUnitId])
}

model StockReservation {
  id                Int                 @id @default(autoincrement())
  projectId         Int?
  project           Project?            @relation(fields: [projectId], references: [id])
  quotationId       Int?
  quotation         Quotation?          @relation(fields: [quotationId], references: [id])
  invoiceId         Int?
  invoice           InvoiceOut?         @relation(fields: [invoiceId], references: [id])
  purchaseRequestId Int?
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  productId         Int?
  product           Product?            @relation(fields: [productId], references: [id])
  serialUnitId      Int?
  serialUnit        SerialUnit?         @relation(fields: [serialUnitId], references: [id])
  qty               Int                 @default(1)
  requirementId     Int?
  requirement       ProjectRequirement? @relation("ReservationRequirement", fields: [requirementId], references: [id], onDelete: SetNull)
  releasedAt        DateTime?
  createdAt         DateTime            @default(now())

  @@index([projectId])
  @@index([quotationId])
  @@index([invoiceId])
  @@index([purchaseRequestId])
  @@index([productId])
  @@index([serialUnitId])
  @@index([releasedAt])
}

model StockOpname {
  id          Int          @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  date        DateTime     @db.Date
  conductorId Int
  conductor   User         @relation(fields: [conductorId], references: [id])
  status      OpnameStatus @default(DRAFT)
  reason      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  details StockOpnameDetail[]

  @@index([status])
  @@index([warehouseId])
}

model StockOpnameDetail {
  id         Int         @id @default(autoincrement())
  opnameId   Int
  opname     StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product     @relation(fields: [productId], references: [id])
  systemQty  Int
  countedQty Int
  diff       Int
  note       String?

  @@index([opnameId])
}

model DamageReport {
  id              Int            @id @default(autoincrement())
  date            DateTime       @db.Date
  productId       Int
  product         Product        @relation(fields: [productId], references: [id])
  serialUnitId    Int?
  serialUnit      SerialUnit?    @relation(fields: [serialUnitId], references: [id])
  type            IssueType
  // Jenis laporan & PO asal retur (dulu tag "[RETUR-PEMBELIAN]" / "[PO: ...]" di description)
  category        DamageCategory @default(KERUSAKAN)
  supplierPoId    Int?
  supplierPo      SupplierPO?    @relation(fields: [supplierPoId], references: [id], onDelete: SetNull)
  qty             Int            @default(1)
  description     String
  // Catatan penggantian (dulu tag "[DIGANTI: ...]" di description)
  replacementNote String?
  fileId          Int?
  file            File?          @relation("DamageReport_fileId", fields: [fileId], references: [id], onDelete: SetNull)
  reporterId      Int
  reporter        User           @relation(fields: [reporterId], references: [id])
  status          DamageStatus   @default(DILAPORKAN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([supplierPoId])
  @@index([category])
}

// ─────────────────────────────── Surat jalan ───────────────────────────────

model DeliveryNote {
  id               Int            @id @default(autoincrement())
  number           String         @unique
  creatorId        Int
  creator          User           @relation("DNCreator", fields: [creatorId], references: [id])
  withGoods        Boolean        @default(false)
  date             DateTime       @db.Date
  status           DeliveryStatus @default(PENDING)
  // Dokumen penjualan yang dikirim (dulu tag "[so:id]" / "[inv:id]" di alasan surat jalan)
  clientPoId       Int?
  clientPo         ClientPO?      @relation(fields: [clientPoId], references: [id], onDelete: SetNull)
  invoiceId        Int?
  invoice          InvoiceOut?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receiveById      Int?
  receivedBy       User?          @relation("DNReceiver", fields: [receiveById], references: [id], onDelete: SetNull)
  receivedAt       DateTime?
  /// Pengirim: karyawan (senderId) atau ekspedisi / kurir luar (senderName) + no. kendaraan
  senderId         Int?
  sender           User?          @relation("DNSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName       String?
  vehicleNo        String?
  /// Gudang asal & petugas gudang yang mengeluarkan barang (menandatangani surat jalan)
  warehouseId      Int?
  warehouse        Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseStaffId Int?
  warehouseStaff   User?          @relation("DNWarehouseStaff", fields: [warehouseStaffId], references: [id], onDelete: SetNull)
  /// Penerima di lokasi. Surat jalan project: PM project (recipientUserId).
  recipientUserId  Int?
  recipientUser    User?          @relation("DNRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientName    String?
  recipientTitle   String?
  recipientPhone   String?
  scanFileId       Int?
  scanFile         File?          @relation("DeliveryNote_scanFileId", fields: [scanFileId], references: [id], onDelete: SetNull)
  reportText       String?        @db.LongText
  reportFileId     Int?
  reportFile       File?          @relation("DeliveryNote_reportFileId", fields: [reportFileId], references: [id], onDelete: SetNull)
  reportAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  locations    DeliveryNoteLocation[]
  items        DeliveryNoteItem[]
  movements    StockMovement[]
  expenses     Expense[]
  cashAdvances CashAdvance[]

  @@index([status])
  @@index([creatorId])
  @@index([date])
  @@index([clientPoId])
  @@index([invoiceId])
  @@index([recipientUserId])
}

model DeliveryNoteLocation {
  id             Int          @id @default(autoincrement())
  deliveryNoteId Int
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  destination    String
  reason         String
  projectId      Int?
  project        Project?     @relation(fields: [projectId], references: [id])

  @@index([deliveryNoteId])
}

model DeliveryNoteItem {
  id             Int          @id @default(autoincrement())
  deliveryNoteId Int
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  qty            Int          @default(1)
  serials        String?      @db.LongText
  note           String?

  @@index([deliveryNoteId])
  @@index([productId])
}

// ─────────────────────────────── (relasi terakhir) ───────────────────────────────

// ─────────────────────────────── HR: Absensi & Payroll ───────────────────────────────

model Attendance {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Restrict)
  date          DateTime  @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        String    @default("HADIR")
  overtimeHours Decimal   @default(0) @db.Decimal(6, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, date])
  @@index([date])
}

/// Data kepegawaian karyawan (master data karyawan). Akun login & jabatan ada di User.
model EmployeeProfile {
  userId          Int       @id
  user            User      @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  employeeNo      String?   @unique
  nik             String?
  npwp            String?
  birthPlace      String?
  birthDate       DateTime? @db.Date
  gender          String?
  address         String?   @db.Text
  joinDate        DateTime? @db.Date
  /// TETAP | KONTRAK | HARIAN | MAGANG
  employmentType  String    @default("TETAP")
  contractEndDate DateTime? @db.Date
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  bpjsKesNo       String?
  bpjsTkNo        String?
  emergencyName   String?
  emergencyPhone  String?
  updatedAt       DateTime  @updatedAt
}

model SalaryConfig {
  userId        Int      @id
  user          User     @relation("SalaryConfigUser", fields: [userId], references: [id], onDelete: Cascade)
  basicSalary   Decimal  @default(0) @db.Decimal(18, 2)
  /// Tunjangan tetap per bulan (ikut dasar BPJS)
  allowance     Decimal  @default(0) @db.Decimal(18, 2)
  /// Uang makan / transport per hari hadir (tunjangan tidak tetap)
  mealAllowance Decimal  @default(0) @db.Decimal(18, 2)
  ptkp          String   @default("TK/0")
  hasNpwp       Boolean  @default(true)
  pph21Rate     Decimal? @db.Decimal(6, 3)
  /// Ikut BPJS Kesehatan / BPJS Ketenagakerjaan (JHT, JKK, JKM) / Jaminan Pensiun
  bpjsKes       Boolean  @default(true)
  bpjsTk        Boolean  @default(true)
  bpjsJp        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model PayrollSlip {
  id              Int       @id @default(autoincrement())
  period          String
  userId          Int
  user            User      @relation("PayrollSlipUser", fields: [userId], references: [id], onDelete: Restrict)
  basicSalary     Decimal   @default(0) @db.Decimal(18, 2)
  allowance       Decimal   @default(0) @db.Decimal(18, 2)
  overtimePay     Decimal   @default(0) @db.Decimal(18, 2)
  absentDeduct    Decimal   @default(0) @db.Decimal(18, 2)
  /// Uang makan / transport (per hari hadir)
  mealAllowance   Decimal   @default(0) @db.Decimal(18, 2)
  /// Bonus / insentif / THR / penghasilan lain periode ini (diisi manual sebelum dibayar)
  otherIncome     Decimal   @default(0) @db.Decimal(18, 2)
  grossSalary     Decimal   @default(0) @db.Decimal(18, 2)
  /// Total iuran BPJS porsi karyawan (dipotong dari gaji)
  bpjs            Decimal   @default(0) @db.Decimal(18, 2)
  /// Total iuran BPJS porsi perusahaan (beban perusahaan, tidak dipotong)
  bpjsCompany     Decimal   @default(0) @db.Decimal(18, 2)
  /// Dasar PPh 21 (bruto + premi JKK/JKM/Kesehatan yang dibayar perusahaan)
  taxBase         Decimal   @default(0) @db.Decimal(18, 2)
  terCategory     String?
  terRate         Decimal   @default(0) @db.Decimal(6, 3)
  pph21           Decimal   @default(0) @db.Decimal(18, 2)
  /// Potongan lain: cicilan pinjaman / kasbon karyawan
  otherDeduction  Decimal   @default(0) @db.Decimal(18, 2)
  netSalary       Decimal   @default(0) @db.Decimal(18, 2)
  /// Rincian BPJS per program (JHT, JP, JKK, JKM, Kesehatan) — porsi karyawan & perusahaan
  detail          Json?
  note            String?   @db.Text
  workDays        Int       @default(0)
  presentDays     Int       @default(0)
  absentDays      Int       @default(0)
  lateCount       Int       @default(0)
  status          String    @default("DRAFT")
  paidAccountCode String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([period, userId])
  @@index([period])
}

// ─────────────────────────────── POC (Proof of Concept / Demo / Expo) ───────────────────────────────

model PocReport {
  id                  Int       @id @default(autoincrement())
  number              String    @unique
  title               String
  description         String?   @db.Text
  date                DateTime  @db.Date
  endDate             DateTime? @db.Date
  location            String?
  type                String    @default("DEMO_CLIENT")
  status              String    @default("Draft")
  resultStatus        String?
  clientName          String?
  customerId          Int?
  customer            Customer? @relation(fields: [customerId], references: [id])
  projectId           Int?
  project             Project?  @relation(fields: [projectId], references: [id])
  leadId              Int?
  lead                Lead?     @relation(fields: [leadId], references: [id])
  targetCriteria      String?   @db.Text
  productsTested      String?   @db.Text
  budget              Decimal   @default(0) @db.Decimal(18, 2)
  actualCost          Decimal   @default(0) @db.Decimal(18, 2)
  actualExecutionDate DateTime? @db.Date
  actualAttendees     String?   @db.Text
  activitiesDone      String?   @db.Text
  testResults         String?   @db.Text
  issuesFound         String?   @db.Text
  followUpNeeded      String?   @db.Text
  conclusion          String?   @db.Text
  recommendations     String?   @db.Text
  companyHeader       String?
  logoFileId          Int?
  logoFile            File?     @relation("PocReport_logoFileId", fields: [logoFileId], references: [id], onDelete: SetNull)
  documentFileId      Int?
  documentFile        File?     @relation("PocReport_documentFileId", fields: [documentFileId], references: [id], onDelete: SetNull)
  ownerId             Int
  owner               User      @relation("PocOwner", fields: [ownerId], references: [id])
  createdById         Int
  createdBy           User      @relation("PocCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members    PocMember[]
  checklists PocChecklist[]
  expenses   Expense[]
  followUps  FollowUp[]

  @@index([status])
  @@index([date])
  @@index([ownerId])
  @@index([projectId])
  @@index([customerId])
}

model PocMember {
  id          Int       @id @default(autoincrement())
  pocReportId Int
  pocReport   PocReport @relation(fields: [pocReportId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@unique([pocReportId, userId])
  @@index([pocReportId])
  @@index([userId])
}

model PocChecklist {
  id          Int       @id @default(autoincrement())
  pocReportId Int
  pocReport   PocReport @relation(fields: [pocReportId], references: [id], onDelete: Cascade)
  title       String
  isDone      Boolean   @default(false)
  dueDate     DateTime? @db.Date
  assigneeId  Int?
  assignee    User?     @relation("PocChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pocReportId])
}

// ─────────────────────────────── Kunjungan / Offline Meeting ───────────────────────────────

model VisitReport {
  id               Int                @id @default(autoincrement())
  number           String             @unique
  title            String
  activityTypeId   Int?
  activityType     VisitActivityType? @relation(fields: [activityTypeId], references: [id])
  activityTypeName String?
  status           String             @default("Planned")
  date             DateTime           @db.Date
  endDate          DateTime?          @db.Date
  location         String?
  clientName       String?
  clientContact    String?
  customerId       Int?
  customer         Customer?          @relation(fields: [customerId], references: [id])
  leadId           Int?
  lead             Lead?              @relation(fields: [leadId], references: [id])
  projectId        Int?
  project          Project?           @relation(fields: [projectId], references: [id])
  purpose          String?            @db.Text
  description      String?            @db.Text

  // Minutes of Meeting (MoM)
  summary                String? @db.Text
  clientNeeds            String? @db.Text
  productsIntroduced     String? @db.Text
  clientFeedback         String? @db.Text
  agreements             String? @db.Text
  potentialOpportunities String? @db.Text
  obstacles              String? @db.Text
  conclusion             String? @db.Text

  // Custom PDF Header & Logo
  companyHeader  String?
  logoFileId     Int?
  logoFile       File?   @relation("VisitReport_logoFileId", fields: [logoFileId], references: [id], onDelete: SetNull)
  documentFileId Int?
  documentFile   File?   @relation("VisitReport_documentFileId", fields: [documentFileId], references: [id], onDelete: SetNull)

  // PIC & Metadata
  ownerId     Int
  owner       User     @relation("VisitOwner", fields: [ownerId], references: [id])
  createdById Int
  createdBy   User     @relation("VisitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   VisitMember[]
  actions   VisitActionItem[]
  expenses  Expense[]
  followUps FollowUp[]

  @@index([status])
  @@index([date])
  @@index([ownerId])
  @@index([projectId])
  @@index([customerId])
  @@index([leadId])
  @@index([activityTypeId])
}

model VisitMember {
  id            Int         @id @default(autoincrement())
  visitReportId Int
  visitReport   VisitReport @relation(fields: [visitReportId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation(fields: [userId], references: [id])

  @@unique([visitReportId, userId])
  @@index([visitReportId])
  @@index([userId])
}

model VisitActionItem {
  id            Int         @id @default(autoincrement())
  visitReportId Int
  visitReport   VisitReport @relation(fields: [visitReportId], references: [id], onDelete: Cascade)
  task          String      @db.Text
  assigneeId    Int?
  assignee      User?       @relation("VisitActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate       DateTime?   @db.Date
  status        String      @default("Open")
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([visitReportId])
  @@index([assigneeId])
}

// ─────────────────────────────── Laporan Maintenance ───────────────────────────────

model MaintenanceReport {
  id              Int       @id @default(autoincrement())
  number          String    @unique
  title           String
  maintenanceType String    @default("Preventive")
  status          String    @default("Scheduled")
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  location        String?
  clientName      String?
  clientContact   String?
  customerId      Int?
  customer        Customer? @relation(fields: [customerId], references: [id])
  leadId          Int?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  projectId       Int?
  project         Project?  @relation(fields: [projectId], references: [id])
  purpose         String?   @db.Text
  description     String?   @db.Text

  // Technical findings & actions
  findings        String? @db.Text
  actionsTaken    String? @db.Text
  recommendations String? @db.Text
  conclusion      String? @db.Text

  // Custom PDF Header & Logo / Document
  companyHeader  String?
  logoFileId     Int?
  logoFile       File?   @relation("MaintenanceReport_logoFileId", fields: [logoFileId], references: [id], onDelete: SetNull)
  documentFileId Int?
  documentFile   File?   @relation("MaintenanceReport_documentFileId", fields: [documentFileId], references: [id], onDelete: SetNull)

  // PIC & Creator
  ownerId     Int
  owner       User     @relation("MaintenanceOwner", fields: [ownerId], references: [id])
  createdById Int
  createdBy   User     @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        MaintenanceMember[]
  actions        MaintenanceActionItem[]
  expenses       Expense[]
  followUps      FollowUp[]
  fixedAssetRefs FaAssetMaintenanceRef[]

  @@index([status])
  @@index([startDate])
  @@index([ownerId])
  @@index([projectId])
  @@index([customerId])
  @@index([leadId])
}

model MaintenanceMember {
  id                  Int               @id @default(autoincrement())
  maintenanceReportId Int
  maintenanceReport   MaintenanceReport @relation(fields: [maintenanceReportId], references: [id], onDelete: Cascade)
  userId              Int
  user                User              @relation(fields: [userId], references: [id])

  @@unique([maintenanceReportId, userId])
  @@index([maintenanceReportId])
  @@index([userId])
}

model MaintenanceActionItem {
  id                  Int               @id @default(autoincrement())
  maintenanceReportId Int
  maintenanceReport   MaintenanceReport @relation(fields: [maintenanceReportId], references: [id], onDelete: Cascade)
  task                String            @db.Text
  assigneeId          Int?
  assignee            User?             @relation("MaintenanceActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate             DateTime?         @db.Date
  status              String            @default("Open")
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([maintenanceReportId])
  @@index([assigneeId])
}

// ─────────────────────────────── Kalender Kerja ───────────────────────────────
model CalendarEvent {
  id                Int         @id @default(autoincrement())
  number            String      @unique
  title             String
  description       String?     @db.Text
  category          String      @default("MEETING")
  status            String      @default("NOT_STARTED")
  priority          String      @default("MEDIUM")
  startDate         DateTime
  endDate           DateTime?
  isAllDay          Boolean     @default(false)
  recurrence        String      @default("NONE")
  recurrenceUntil   DateTime?
  reminderMinutes   Int?
  lastRemindedAt    DateTime?
  completionNote    String?     @db.Text
  creatorId         Int
  creator           User        @relation("CalendarCreator", fields: [creatorId], references: [id])
  assigneeId        Int?
  assignee          User?       @relation("CalendarAssignee", fields: [assigneeId], references: [id])
  customerId        Int?
  customer          Customer?   @relation("CalendarCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  projectId         Int?
  project           Project?    @relation("CalendarProject", fields: [projectId], references: [id], onDelete: SetNull)
  leadId            Int?
  lead              Lead?       @relation("CalendarLead", fields: [leadId], references: [id], onDelete: SetNull)
  invoiceId         Int?
  invoice           InvoiceOut? @relation("CalendarInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  supplierId        Int?
  supplier          Supplier?   @relation("CalendarSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  excludedDates     String?     @db.Text
  overdueNotifiedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  attendees CalendarAttendee[]

  @@index([startDate])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([category])
}

model CalendarAttendee {
  id      Int           @id @default(autoincrement())
  eventId Int
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  Int
  user    User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
}

// ─────────────────────────────── Bagan Akun (COA) & Akuntansi ───────────────────────────────
enum JournalStatus {
  POSTED
  REVERSED
}

enum PeriodStatus {
  OPEN
  REQUESTED_CLOSE
  CLOSED
}

model CoaAccount {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  name          String
  category      String
  normalBalance String       @default("DEBIT")
  type          String?
  parentCode    String?
  parent        CoaAccount?  @relation("CoaHierarchy", fields: [parentCode], references: [code], onDelete: SetNull)
  children      CoaAccount[] @relation("CoaHierarchy")
  isPostable    Boolean      @default(true)
  isCash        Boolean      @default(false)
  isSystem      Boolean      @default(false)
  status        String       @default("AKTIF")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lines    JournalLine[]
  mappings AccountMapping[]

  @@index([parentCode])
  @@index([category])
}

model JournalEntry {
  id           Int              @id @default(autoincrement())
  number       String           @unique
  date         DateTime         @db.Date
  source       String
  sourceType   String?
  sourceId     Int?
  event        String?
  version      Int              @default(1)
  memo         String           @db.Text
  refNo        String?
  projectId    Int?
  status       JournalStatus    @default(POSTED)
  reversalOfId Int?             @unique
  reversalOf   JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry?    @relation("JournalReversal")
  periodId     Int
  period       AccountingPeriod @relation(fields: [periodId], references: [id])
  createdById  Int?
  createdAt    DateTime         @default(now())

  lines JournalLine[]

  @@unique([sourceType, sourceId, event, version])
  @@index([date])
  @@index([source])
  @@index([projectId])
  @@index([periodId])
}

model JournalLine {
  id          Int          @id @default(autoincrement())
  entryId     Int
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  lineNo      Int
  accountCode String
  account     CoaAccount   @relation(fields: [accountCode], references: [code])
  debit       Decimal      @default(0) @db.Decimal(18, 2)
  credit      Decimal      @default(0) @db.Decimal(18, 2)
  memo        String?
  projectId   Int?
  partyType   String?
  partyId     Int?

  @@index([entryId])
  @@index([accountCode])
  @@index([projectId])
  @@index([partyType, partyId])
}

model AccountingPeriod {
  id            Int            @id @default(autoincrement())
  year          Int
  month         Int
  status        PeriodStatus   @default(OPEN)
  requestedAt   DateTime?
  requestedById Int?
  closedAt      DateTime?
  closedById    Int?
  reopenedAt    DateTime?
  reopenedById  Int?
  note          String?
  reopenReason  String?
  entries       JournalEntry[]

  @@unique([year, month])
}

model FiscalYear {
  year           Int          @id
  status         PeriodStatus @default(OPEN)
  closingEntryId Int?         @unique
  closedAt       DateTime?
  closedById     Int?
  reopenedAt     DateTime?
  reopenedById   Int?
  reopenReason   String?
}

model AccountMapping {
  key         String     @id
  accountCode String
  account     CoaAccount @relation(fields: [accountCode], references: [code])
  updatedAt   DateTime   @updatedAt
}

// ─────────────────────────────── Subscription Management ───────────────────────────────

model SubCategory {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  name                String
  subcategory         String?
  defaultBillingCycle String   @default("ANNUAL")
  expenseAccountCode  String   @default("6122")
  prepaidAccountCode  String   @default("1401")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions SubSubscription[]

  @@index([isActive])
  @@map("sub_categories")
}

model SubProvider {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique
  name                  String
  website               String?
  supportEmail          String?
  supportPhone          String?
  loginPortalUrl        String?
  accountRepresentative String?
  isSeeded              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions SubSubscription[]

  @@index([name])
  @@map("sub_providers")
}

model SubSubscription {
  id                 Int          @id @default(autoincrement())
  subscriptionCode   String       @unique
  serviceName        String
  categoryId         Int
  category           SubCategory  @relation(fields: [categoryId], references: [id])
  providerId         Int?
  provider           SubProvider? @relation(fields: [providerId], references: [id])
  providerName       String?
  accountIdentifier  String?
  serviceUrl         String?
  subscriptionPlan   String?
  billingCycle       String       @default("ANNUAL")
  startDate          DateTime     @db.Date
  expirationDate     DateTime?    @db.Date
  nextRenewalDate    DateTime?    @db.Date
  autoRenewal        Boolean      @default(false)
  currency           String       @default("IDR")
  cost               Decimal      @db.Decimal(18, 2)
  tax                Decimal      @default(0.00) @db.Decimal(18, 2)
  originalCurrency   String?
  originalAmount     Decimal?     @db.Decimal(18, 2)
  exchangeRate       Decimal?     @db.Decimal(18, 4)
  exchangeRateDate   DateTime?    @db.Date
  idrEquivalent      Decimal?     @db.Decimal(18, 2)
  mrc                Decimal      @db.Decimal(18, 2)
  arc                Decimal      @db.Decimal(18, 2)
  department         String
  picUserId          Int?
  businessPurpose    String       @db.Text
  status             String       @default("ACTIVE")
  paymentStatus      String       @default("UNPAID")
  expenseAccountCode String?
  prepaidAccountCode String?
  notes              String?      @db.Text
  createdById        Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  allocations          SubCostAllocation[]
  renewalHistory       SubRenewalHistory[]
  priceHistory         SubPriceHistory[]
  usageRecords         SubUsageRecord[]
  paymentRecords       SubPaymentRecord[]
  prepaidSchedules     SubPrepaidSchedule[]
  billingSchedules     SubBillingSchedule[]
  cancellationRequests SubCancellationRequest[]
  documents            SubDocument[]
  reminderLogs         SubReminderLog[]

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([nextRenewalDate])
  @@index([department])
  @@index([picUserId])
  @@map("sub_subscriptions")
}

model SubCostAllocation {
  id              Int             @id @default(autoincrement())
  subscriptionId  Int
  subscription    SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  department      String
  projectId       Int?
  percentage      Decimal         @db.Decimal(5, 2)
  allocatedAmount Decimal         @db.Decimal(18, 2)
  createdAt       DateTime        @default(now())

  @@index([subscriptionId])
  @@index([department])
  @@index([projectId])
  @@map("sub_cost_allocations")
}

model SubRenewalHistory {
  id                  Int             @id @default(autoincrement())
  renewalCode         String          @unique
  subscriptionId      Int
  subscription        SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousPeriodStart DateTime        @db.Date
  previousPeriodEnd   DateTime        @db.Date
  newPeriodStart      DateTime        @db.Date
  newPeriodEnd        DateTime        @db.Date
  previousCost        Decimal         @db.Decimal(18, 2)
  renewalCost         Decimal         @db.Decimal(18, 2)
  invoiceNumber       String?
  approvalStatus      String          @default("APPROVED")
  approvedByUserId    Int?
  approvedAt          DateTime?
  notes               String?         @db.Text
  createdById         Int?
  createdAt           DateTime        @default(now())

  @@index([subscriptionId])
  @@index([newPeriodStart])
  @@map("sub_renewal_history")
}

model SubPriceHistory {
  id               Int             @id @default(autoincrement())
  subscriptionId   Int
  subscription     SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changeType       String
  previousPlan     String?
  newPlan          String
  previousCost     Decimal         @db.Decimal(18, 2)
  newCost          Decimal         @db.Decimal(18, 2)
  effectiveDate    DateTime        @db.Date
  changeReason     String          @db.Text
  approvedByUserId Int?
  createdById      Int?
  createdAt        DateTime        @default(now())

  @@index([subscriptionId])
  @@index([changeType])
  @@index([effectiveDate])
  @@map("sub_price_history")
}

model SubUsageRecord {
  id                Int             @id @default(autoincrement())
  subscriptionId    Int
  subscription      SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  usersCount        Int?
  licensesCount     Int?
  storageCapacity   String?
  serverSpecs       String?
  utilizationStatus String          @default("OPTIMAL")
  evaluationNotes   String?         @db.Text
  lastReviewedDate  DateTime?       @db.Date
  reviewedByUserId  Int?
  createdAt         DateTime        @default(now())

  @@index([subscriptionId])
  @@index([utilizationStatus])
  @@map("sub_usage_records")
}

model SubPaymentRecord {
  id               Int             @id @default(autoincrement())
  subscriptionId   Int
  subscription     SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber    String?
  invoiceDate      DateTime?       @db.Date
  dueDate          DateTime?       @db.Date
  paymentDate      DateTime?       @db.Date
  billingPeriod    String?
  amount           Decimal         @db.Decimal(18, 2)
  tax              Decimal         @default(0.00) @db.Decimal(18, 2)
  currency         String          @default("IDR")
  paymentStatus    String          @default("PAID")
  financeJournalId Int?
  paymentProofUrl  String?         @db.Text
  notes            String?         @db.Text
  createdById      Int?
  createdAt        DateTime        @default(now())

  @@index([subscriptionId])
  @@index([paymentDate])
  @@index([paymentStatus])
  @@map("sub_payment_records")
}

model SubPrepaidSchedule {
  id             Int             @id @default(autoincrement())
  subscriptionId Int
  subscription   SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodYear     Int
  periodMonth    Int
  allocationDate DateTime        @db.Date
  amount         Decimal         @db.Decimal(18, 2)
  isPosted       Boolean         @default(false)
  journalNumber  String?
  journalEntryId Int?
  postedAt       DateTime?
  postedById     Int?
  createdAt      DateTime        @default(now())

  @@unique([subscriptionId, periodYear, periodMonth])
  @@index([periodYear, periodMonth, isPosted])
  @@map("sub_prepaid_schedules")
}

model SubBillingSchedule {
  id             Int             @id @default(autoincrement())
  subscriptionId Int
  subscription   SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dueDate        DateTime        @db.Date
  periodLabel    String?
  amount         Decimal         @db.Decimal(18, 2)
  status         String          @default("DRAFT")
  journalEntryId Int?
  confirmedAt    DateTime?
  confirmedById  Int?
  createdAt      DateTime        @default(now())

  @@unique([subscriptionId, dueDate])
  @@index([subscriptionId, status])
  @@map("sub_billing_schedules")
}

model SubCancellationRequest {
  id                          Int             @id @default(autoincrement())
  subscriptionId              Int
  subscription                SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cancellationCode            String          @unique
  reason                      String          @db.Text
  requestedByUserId           Int
  effectiveCancellationDate   DateTime        @db.Date
  finalBillingDate            DateTime?       @db.Date
  isDataBackupConfirmed       Boolean         @default(false)
  isServiceMigrationConfirmed Boolean         @default(false)
  isDnsMigrationConfirmed     Boolean         @default(false)
  isDependencyCheckConfirmed  Boolean         @default(false)
  isHandoverConfirmed         Boolean         @default(false)
  isTerminationConfirmed      Boolean         @default(false)
  approvedByUserId            Int?
  status                      String          @default("PENDING")
  notes                       String?         @db.Text
  approvedAt                  DateTime?
  executedAt                  DateTime?
  createdAt                   DateTime        @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@map("sub_cancellation_requests")
}

model SubDocument {
  id               Int             @id @default(autoincrement())
  subscriptionId   Int
  subscription     SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  title            String
  documentType     String
  fileUrl          String          @db.Text
  fileSize         Int?
  mimeType         String?
  uploadedByUserId Int?
  createdAt        DateTime        @default(now())

  @@index([subscriptionId])
  @@index([documentType])
  @@map("sub_documents")
}

model SubReminderLog {
  id              Int             @id @default(autoincrement())
  subscriptionId  Int
  subscription    SubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  reminderType    String
  recipientUserId Int?
  message         String          @db.Text
  channel         String          @default("SYSTEM")
  sentAt          DateTime        @default(now())

  @@index([subscriptionId, reminderType, sentAt])
  @@index([sentAt])
  @@map("sub_reminder_logs")
}

// ─────────────────────────────── Fixed Asset Management ───────────────────────────────

model FaCategory {
  id                      Int      @id @default(autoincrement())
  code                    String   @unique
  name                    String
  type                    String   @default("TANGIBLE")
  defaultUsefulLifeMonths Int      @default(48)
  depreciationMethod      String   @default("STRAIGHT_LINE")
  defaultResidualRate     Decimal  @default(0.00) @db.Decimal(5, 2)
  assetAccountCode        String?
  accumDepAccountCode     String?
  depExpenseAccountCode   String?
  capitalizationThreshold Decimal  @default(0.00) @db.Decimal(18, 2)
  description             String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  assets FaAsset[]

  @@map("fa_categories")
}

model FaLocation {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  building    String?
  floor       String?
  room        String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets FaAsset[]

  @@map("fa_locations")
}

model FaAsset {
  id                      Int         @id @default(autoincrement())
  assetCode               String      @unique
  name                    String
  categoryId              Int
  category                FaCategory  @relation(fields: [categoryId], references: [id])
  type                    String      @default("TANGIBLE")
  description             String?     @db.Text
  brand                   String?
  model                   String?
  serialNumber            String?
  acquisitionDate         DateTime    @db.Date
  inServiceDate           DateTime    @db.Date
  acquisitionCost         Decimal     @db.Decimal(18, 2)
  residualValue           Decimal     @default(0.00) @db.Decimal(18, 2)
  usefulLifeMonths        Int         @default(48)
  depreciationMethod      String      @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal     @default(0.00) @db.Decimal(18, 2)
  bookValue               Decimal     @db.Decimal(18, 2)
  locationId              Int?
  location                FaLocation? @relation(fields: [locationId], references: [id])
  department              String?
  assignedUserId          Int?
  assignedUser            User?       @relation("FaAssetAssignedUser", fields: [assignedUserId], references: [id])
  warrantyExpiry          DateTime?   @db.Date
  condition               String      @default("GOOD")
  status                  String      @default("REGISTERED")
  photoUrl                String?     @db.Text
  documentUrl             String?     @db.Text
  qrCodeKey               String?     @unique
  acquisitionSource       String      @default("DIRECT_PURCHASE")
  receivingId             Int?
  purchaseRequestId       Int?
  customFields            String?     @db.Text
  createdById             Int?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  assignments           FaAssetAssignment[]
  transfers             FaAssetTransfer[]
  depreciationSchedules FaDepreciationSchedule[]
  amortizationSchedules FaAmortizationSchedule[]
  disposals             FaAssetDisposal[]
  auditItems            FaAssetAuditItem[]
  documents             FaAssetDocument[]
  maintenanceRefs       FaAssetMaintenanceRef[]
  ledgerEntries         FaAssetLedger[]
  maintenancePlanAssets MaintPlanAsset[]
  maintenanceSchedules  MaintSchedule[]
  maintenanceRequests   MaintRequest[]
  maintenanceWorkOrders MaintWorkOrder[]
  maintenanceHistories  MaintHistory[]
  maintenanceDowntimes  MaintDowntime[]

  @@index([categoryId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([status])
  @@map("fa_assets")
}

model FaAcquisition {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  source        String
  vendorName    String?
  invoiceNumber String?
  invoiceDate   DateTime? @db.Date
  poNumber      String?
  receivingId   Int?
  totalCost     Decimal   @db.Decimal(18, 2)
  notes         String?   @db.Text
  status        String    @default("COMPLETED")
