{
  "expo": {
    "name": "Akuntra - ERP",
    "slug": "akuntra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AKUNTRA.png",
    "scheme": "akuntra",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/AKUNTRA.png"
    },
    "android": {
      "package": "id.co.ghinamultiprima.akuntra",
      "adaptiveIcon": {
        "backgroundColor": "#181716",
        "foregroundImage": "./assets/AKUNTRA.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/AKUNTRA.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181716",
          "image": "./assets/AKUNTRA.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "akuntra-realtime"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Akuntra memerlukan akses lokasi GPS untuk mencatat koordinat presensi kehadiran Anda."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
