{
  "expo": {
    "name": "Akuntra - ERP",
    "slug": "akuntra",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a46c3c2-8f79-46d2-90da-04192e7d80a6",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/AKUNTRA.png",
    "scheme": "akuntra",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/AKUNTRA.png"
    },
    "android": {
      "package": "id.co.ghinamultiprima.akuntra",
      "adaptiveIcon": {
        "backgroundColor": "#181716",
        "foregroundImage": "./assets/AKUNTRA.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/AKUNTRA.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181716",
          "image": "./assets/AKUNTRA.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "akuntra-realtime"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Akuntra memerlukan akses lokasi GPS untuk mencatat koordinat presensi kehadiran Anda."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Akuntra memerlukan akses kamera untuk memindai barcode/QR nomor seri barang, aset tetap, dan bukti dokumentasi."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8a46c3c2-8f79-46d2-90da-04192e7d80a6"
      }
    }
  }
}
