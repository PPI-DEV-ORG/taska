{
  "expo": {
    "name": "Taska - Mini ERP",
    "slug": "taska",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/taska-logo.png",
    "scheme": "taska",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/taska-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0f14",
        "foregroundImage": "./assets/taska-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/taska-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0f14",
          "image": "./assets/taska-logo.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
